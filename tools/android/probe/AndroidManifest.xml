<?xml version="1.0" encoding="utf-8"?>
<!-- BLITZ DS probe (docs/BLITZ_DS.md): no game, just what a device can do. tools/android/probe/build.sh makes the APK. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.blitzrecomp.probe" android:versionCode="1" android:versionName="1">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <application android:label="Blitz Probe" android:hardwareAccelerated="true" android:usesCleartextTraffic="false"
        android:extractNativeLibs="false" android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <uses-library android:name="com.microsoft.device.display.displaymask" android:required="false" />
        <activity android:name=".ProbeActivity" android:exported="true" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ProbeActivity$ProbeSecond" android:exported="false" android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode" />
        <provider android:name=".ProbeFiles" android:authorities="com.blitzrecomp.probe.files"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
