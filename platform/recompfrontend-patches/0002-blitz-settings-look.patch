+    if (device == recompinput::InputDevice::Keyboard) {
+        switch (action) {
+            case MenuAction::Back: return recompinput::InputField::keyboard(SDL_SCANCODE_BACKSPACE);
+            case MenuAction::TabLeft: return recompinput::InputField::keyboard(SDL_SCANCODE_PAGEUP);
+            case MenuAction::TabRight: return recompinput::InputField::keyboard(SDL_SCANCODE_PAGEDOWN);
+            default: break;
+        }
+    }
+    recompinput::GameInput input = menu_action_mapping::game_input_from_menu_action(action);
+    if (input == recompinput::GameInput::COUNT || profile < 0) {
+        return {};
+    }
+    for (size_t i = 0; i < recompinput::num_bindings_per_input; i++) {
+        auto binding = recompinput::profiles::get_input_binding(profile, input, i);
+        if (binding.is_empty()) {
+            continue;
+        }
+        if (binding.input_type == recompinput::InputType::Keyboard && menu_action_mapping::is_sdl_input_fake_mapped(binding.input_id)) {
+            continue;
+        }
+        return binding;
+    }
+    return {};
+}
+
+// PromptFont draws shoulders and triggers small inside the em, so they get a bigger size.
+static bool is_small_glyph(const recompinput::InputField &field) {
+    if (field.input_type == recompinput::InputType::ControllerDigital) {
+        return field.input_id == SDL_CONTROLLER_BUTTON_LEFTSHOULDER || field.input_id == SDL_CONTROLLER_BUTTON_RIGHTSHOULDER;
+    }
+    if (field.input_type == recompinput::InputType::ControllerAnalog) {
+        int axis = field.input_id - 1;
+        return axis == SDL_CONTROLLER_AXIS_TRIGGERLEFT || axis == SDL_CONTROLLER_AXIS_TRIGGERRIGHT;
+    }
+    return false;
+}
+
+void build_hint_row(ContextId context, Element *row, const std::vector<HintItem> &items, recompinput::InputDevice device, int profile) {
+    row->clear_children();
+    if (device == recompinput::InputDevice::COUNT) {
+        return;
+    }
+    for (const HintItem &item : items) {
+        std::vector<recompinput::InputField> glyphs;
+        for (MenuAction action : item.actions) {
+            recompinput::InputField field = hint_binding(action, device, profile);
+            if (!field.is_empty()) {
+                glyphs.push_back(field);
+            }
+        }
+        if (glyphs.empty()) {
+            continue;
+        }
+        auto item_wrapper = context.create_element<Element>(row, 0, "span", false);
+        item_wrapper->set_display(Display::Flex);
+        item_wrapper->set_flex_direction(FlexDirection::Row);
+        item_wrapper->set_align_items(AlignItems::Center);
+        item_wrapper->set_gap(12.0f);
+        item_wrapper->set_color(theme::color::Text);
+        auto glyph_wrapper = context.create_element<Element>(item_wrapper, 0, "span", false);
+        glyph_wrapper->set_display(Display::Flex);
+        glyph_wrapper->set_align_items(AlignItems::Center);
+        glyph_wrapper->set_gap(6.0f);
+        for (const auto &field : glyphs) {
+            auto glyph = context.create_element<Label>(glyph_wrapper, field.to_string(), theme::Typography::LabelSM);
+            glyph->set_font_family("promptfont");
+            glyph->set_font_style(FontStyle::Normal);
+            glyph->set_font_weight(400);
+            glyph->set_font_size(is_small_glyph(field) ? 66.0f : 54.0f);
+            glyph->set_letter_spacing(0.0f);
+        }
+        std::string caps = item.label;
+        for (char &c : caps) c = (char)std::toupper((unsigned char)c);
+        auto label = context.create_element<Label>(item_wrapper, caps, theme::Typography::LabelSM);
+        label->set_font_size(30.0f);
+        label->set_white_space(WhiteSpace::Nowrap);
+    }
+}
