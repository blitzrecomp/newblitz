+// BLITZ DS: the second screen's UI, its own small RmlUi context of plain RML that the game writes (src/game/ds_view.cpp).
+extern "C" void (*blitz_ds_second_hook)(plume::RenderCommandList*, plume::RenderFramebuffer*);
+namespace {
+    Rml::Context* ds_context = nullptr;
+    Rml::ElementDocument* ds_document = nullptr;
+    std::mutex ds_panel_mutex;
+    std::string ds_panel_pending;
+    std::vector<recompui::DsMover> ds_movers;
+    std::vector<recompui::DsMover> ds_movers_applied;
+}
+
+extern "C" volatile int blitz_ds_second_dirty;  // rt64_present_queue.cpp: an idle second screen isn't redrawn
+
+// On the UI tick, like every other element made or destroyed: RmlUi's element pools aren't safe from two threads.
+void recompui::ds_panel_set(const std::string& rml) {
+    {
+        std::lock_guard lock{ ds_panel_mutex };
+        if (ds_panel_pending == rml) return;
+        ds_panel_pending = rml;
+        ds_movers.clear();
+    }
+    std::lock_guard ui_lock{ ui_state_mutex };
+    if (!ui_state) {
+        return;
+    }
+    if (ds_context == nullptr) {
+        ds_context = Rml::CreateContext("ds", Rml::Vector2i(640, 480));
+        ds_document = ds_context->LoadDocumentFromMemory(
+            "<rml><head><style>body{position:absolute;left:0;right:0;top:0;bottom:0;font-family:\"Inter Variable\";color:#fff;}"
+            "div{display:block;}</style></head><body></body></rml>");
+        if (ds_document != nullptr) {
+            ds_document->Show();
+        }
+    }
+    if (ds_document != nullptr) {
+        ds_document->SetInnerRML(rml);
+    }
+    ds_movers_applied.clear();
+    blitz_ds_second_dirty = 1;
+}
+
+void recompui::ds_panel_move(const DsMover* movers, int count) {
+    std::lock_guard lock{ ds_panel_mutex };
+    ds_movers.assign(movers, movers + count);
+}
+
+static void ds_draw_hook(plume::RenderCommandList* command_list, plume::RenderFramebuffer* framebuffer) {
+    std::vector<recompui::DsMover> movers;
+    {
+        std::lock_guard panel_lock{ ds_panel_mutex };
+        movers = ds_movers;
+    }
+    // During a play with no icon up, there's nothing to draw over the picture: skip the whole pass.
+    if (!movers.empty()) {
+        bool any = false;
+        for (const recompui::DsMover& m : movers) any = any || m.on;
+        if (!any) return;
+    }
+    std::lock_guard lock{ ui_state_mutex };
+    if (!ui_state || (ds_document == nullptr)) {
+        return;
+    }
+    int width = framebuffer->getWidth();
+    int height = framebuffer->getHeight();
+    ds_movers_applied.resize(movers.size());
+    for (size_t i = 0; i < movers.size(); i++) {
+        recompui::DsMover& was = ds_movers_applied[i];
+        const recompui::DsMover& now = movers[i];
+        if (was.on == now.on && was.x == now.x && was.y == now.y) continue;
+        was = now;
+        Rml::Element* element = ds_document->GetElementById("b" + std::to_string(i));
+        if (element == nullptr) continue;
+        element->SetProperty("display", now.on ? "block" : "none");
+        if (now.on) {
+            element->SetProperty("left", std::to_string(now.x * 100.0f) + "%");
+            element->SetProperty("top", std::to_string(now.y * 100.0f) + "%");
+        }
+    }
+    ds_context->SetDensityIndependentPixelRatio(height / 1080.0f);
+    ui_state->render_interface.start(command_list, width, height);
+    ds_context->SetDimensions({ width, height });
+    ds_context->Update();
+    ds_context->GetRenderManager().SetViewport({ width, height });
+    ds_context->Render();
+    ui_state->render_interface.end(command_list, framebuffer);
+}
+
 void deinit_hook() {
+    blitz_ds_second_hook = nullptr;
     recompui::destroy_all_contexts();
 
