+namespace { std::string ds_icons_pending, ds_icons_set_rml; }
+void recompui::ds_icons_set(const std::string& rml) {
+    {
+        std::lock_guard lock{ ds_panel_mutex };
+        if (ds_icons_set_rml == rml) return;
+        ds_icons_set_rml = rml;
+    }
+    std::lock_guard ui_lock{ ui_state_mutex };
+    if (!ui_state) {
+        return;
+    }
+    if (ds_icons_context == nullptr) {
+        ds_icons_context = Rml::CreateContext("ds_icons", Rml::Vector2i(640, 480));
+        ds_icons_document = ds_icons_context->LoadDocumentFromMemory(
+            "<rml><head><style>body{position:absolute;left:0;right:0;top:0;bottom:0;font-family:\"Inter Variable\";color:#fff;}"
+            "div{display:block;}</style></head><body></body></rml>");
+        if (ds_icons_document != nullptr) {
+            ds_icons_document->Show();
+        }
+    }
+    if (ds_icons_document != nullptr) {
+        ds_icons_document->SetInnerRML(rml);
+    }
+    ds_movers_applied.clear();
+    blitz_ds_second_dirty = 1;
+}
