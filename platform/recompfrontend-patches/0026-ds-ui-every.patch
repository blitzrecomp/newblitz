--- a/recompui/src/base/ui_state.cpp
+++ b/recompui/src/base/ui_state.cpp
@@ -529,8 +529,34 @@ void init_hook(plume::RenderInterface* interface, plume::RenderDevice* device) {
 
 moodycamel::ConcurrentQueue<SDL_Event> ui_event_queue{};
 
+// BLITZ DS (rt64_present_queue.cpp's BLITZ_DS_UI_EVERY): picture-first may leave the first window as it was for a frame. An event
+// the UI can answer wakes it for the next: a press or a tap, a key, the window changing. Not the streams that come with play: a
+// stick's moves (and their raw joystick twins), a pointer or finger moving, buttons let go. While a context takes input or the
+// mouse, the draw wakes it every frame itself (draw_hook), so those count there anyway.
+extern "C" void blitz_ds_ui_wake(void);
+static bool ui_event_wakes(const SDL_Event& event) {
+    switch (event.type) {
+    case SDL_MOUSEBUTTONDOWN:
+    case SDL_MOUSEBUTTONUP:
+    case SDL_MOUSEWHEEL:
+    case SDL_FINGERDOWN:
+    case SDL_FINGERUP:
+    case SDL_KEYDOWN:
+    case SDL_TEXTINPUT:
+    case SDL_TEXTEDITING:
+    case SDL_CONTROLLERBUTTONDOWN:
+    case SDL_WINDOWEVENT:
+        return true;
+    default:
+        return false;
+    }
+}
+
 void recompui::queue_event(const SDL_Event& event) {
     ui_event_queue.enqueue(event);
+    if (ui_event_wakes(event)) {
+        blitz_ds_ui_wake();
+    }
 }
 
 bool recompui::try_deque_event(SDL_Event& out) {
@@ -930,6 +956,11 @@ void draw_hook(plume::RenderCommandList* command_list, plume::RenderFramebuffer*
         ui_state->context->Render();
         ui_state->render_interface.end(command_list, swap_chain_framebuffer);
     }
+
+    // BLITZ DS (BLITZ_DS_UI_EVERY): a menu's up, or anything else that takes input or the mouse: every frame, as ever.
+    if (ui_state->is_context_capturing_input() || ui_state->is_context_capturing_mouse()) {
+        blitz_ds_ui_wake();
+    }
 }
 
