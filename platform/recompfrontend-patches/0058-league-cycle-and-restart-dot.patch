+ConfigOptionCycle::ConfigOptionCycle(
+    ResourceId rid,
+    Element *parent,
+    std::string option_id,
+    size_t option_index,
+    const recomp::config::Config *config,
+    set_option_value_t set_option_value,
+    on_option_hover_t on_hover,
+    std::function<std::vector<config::CycleChoice>()> choices_fn,
+    bool confirm
+) : ConfigOptionElement(rid, parent, option_id, option_index, config, set_option_value, on_hover), choices(std::move(choices_fn)),
+    confirm(confirm)
+{
+    // Update events (queue_update, each frame) follow the list.
+    ContextId context = recompui::get_current_context();
+    value_button = context.create_element<CycleValue>(this, this);
+    value_button->set_flex_shrink(0.0f);
+    prev_icon = context.create_element<Svg>(value_button, "icons/ChevronLeft.svg");
+    prev_icon->set_width(26.0f);
+    prev_icon->set_height(26.0f);
+    prev_icon->set_pointer_events(PointerEvents::None);
+    Element *middle = context.create_element<Element>(value_button, 0, "div", false);
+    middle->set_display(Display::Flex);
+    middle->set_flex_direction(FlexDirection::Column);
+    middle->set_align_items(AlignItems::Center);
+    middle->set_min_width(250.0f);
+    middle->set_pointer_events(PointerEvents::None);
+    value_label = context.create_element<Label>(middle, "", theme::Typography::LabelMD);
+    value_label->set_text_align(TextAlign::Center);
+    value_label->set_white_space(WhiteSpace::Nowrap);
+    value_label->set_pointer_events(PointerEvents::None);
+    hint_label = context.create_element<Label>(middle, "PRESS × TO CHOOSE", theme::Typography::LabelXS);
+    hint_label->set_color(theme::color::Warning);
+    hint_label->set_white_space(WhiteSpace::Nowrap);
+    hint_label->set_display(Display::None);
+    hint_label->set_pointer_events(PointerEvents::None);
+    next_icon = context.create_element<Svg>(value_button, "icons/ChevronRight.svg");
+    next_icon->set_width(26.0f);
+    next_icon->set_height(26.0f);
+    next_icon->set_pointer_events(PointerEvents::None);
+    refresh();
+    update_disabled();
+    queue_update();
+}
+
+std::string ConfigOptionCycle::key() const { return config->id + "/" + option_id; }
+
+std::string ConfigOptionCycle::current_value() {
+    if (confirm) {
+        if (auto b = config::get_option_browse(config->id, option_id)) return *b;
+    }
+    return std::get<std::string>(get_value());
+}
+
+void ConfigOptionCycle::process_event(const Event &e) {
+    if (e.type == EventType::Update) {
+        refresh();
+        queue_update();
+        return;
+    }
+    ConfigOptionElement::process_event(e);
+}
+
+void ConfigOptionCycle::refresh() {
+    const std::string value = current_value();
+    std::string label = value;
+    for (const config::CycleChoice &c : choices()) {
+        if (c.value == value) {
+            label = c.label;
+            break;
+        }
+    }
+    int state = confirm && config::get_option_browse(config->id, option_id) ? 1 : 0;
+    if (label != shown) {
+        shown = label;
+        value_label->set_text(label);
+    }
+    if (state != shown_state) {
+        shown_state = state;
+        value_label->set_color(state ? theme::color::TextDim : theme::color::SecondaryL);
+        hint_label->set_display(state ? Display::Block : Display::None);
+    }
+}
+
+void ConfigOptionCycle::step(int dir) {
+    if (get_disabled()) {
+        return;
+    }
+    std::vector<config::CycleChoice> list = choices();
+    if (list.empty()) {
+        return;
+    }
+    const std::string value = current_value();
+    int at = -1;
+    for (size_t i = 0; i < list.size(); i++) {
+        if (list[i].value == value) {
+            at = (int)i;
+        }
+    }
+    int n = (int)list.size();
+    int next = at < 0 ? (dir > 0 ? 0 : n - 1) : ((at + dir) % n + n) % n;
+    if (next == at) {
+        return;
+    }
+    const std::string &to = list[(size_t)next].value;
+    if (confirm) {
+        // Browsing: the option keeps its value until the choice; back on it is no browse at all.
+        if (to == std::get<std::string>(get_value())) config::set_option_browse(config->id, option_id, std::nullopt);
+        else config::set_option_browse(config->id, option_id, to);
+    }
+    else {
+        set_option_value(option_id, to);
+    }
+    refresh();
+}
+
+void ConfigOptionCycle::choose() {
+    if (get_disabled() || !confirm) {
+        return;
+    }
+    auto b = config::get_option_browse(config->id, option_id);
+    if (!b) {
+        return;  // the chosen one already
+    }
+    std::string to = *b;
+    config::set_option_browse(config->id, option_id, std::nullopt);
+    set_option_value(option_id, to);
+    refresh();
+}
+
+void ConfigOptionCycle::update_disabled() {
+    value_button->set_enabled(!get_disabled());
+}
