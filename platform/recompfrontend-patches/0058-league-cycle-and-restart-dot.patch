+CycleValue::CycleValue(ResourceId rid, Element *parent, ConfigOptionCycle *owner)
+    : Element(rid, parent, Events(EventType::Click, EventType::Focus, EventType::Hover, EventType::Navigate, EventType::Enable), "button", false),
+      owner(owner) {
+    set_display(Display::Flex);
+    set_flex_direction(FlexDirection::Row);
+    set_align_items(AlignItems::Center);
+    set_gap(10.0f);
+    set_padding_left(10.0f);
+    set_padding_right(10.0f);
+    set_padding_top(4.0f);
+    set_padding_bottom(4.0f);
+    set_border_width(theme::border::width);
+    set_border_radius(theme::border::radius_md);
+    set_border_color(theme::color::BorderSoft);
+    set_background_color(theme::color::Background3);
+    set_cursor(Cursor::Pointer);
+    enable_focus();
+    set_focusable(true);
+    set_nav_none(NavDirection::Left);   // left and right step through the list (as a slider's do)
+    set_nav_none(NavDirection::Right);
+}
+
+void CycleValue::process_event(const Event &e) {
+    switch (e.type) {
+    case EventType::Navigate: {
+        NavDirection dir = std::get<EventNavigate>(e.variant).direction;
+        if (dir == NavDirection::Left) owner->step(-1);
+        else if (dir == NavDirection::Right) owner->step(1);
+        break;
+    }
+    case EventType::Click: {
+        // A tap or a click lands somewhere: the outer quarters are the arrows, the middle the name. Accept (×, Enter)
+        // comes as a click with no position.
+        const auto &c = std::get<EventClick>(e.variant);
+        float left = get_absolute_left(), width = get_client_width();
+        if ((c.x != 0.0f || c.y != 0.0f) && width > 0.0f) {
+            float at = (c.x - left) / width;
+            if (at < 0.25f) { owner->step(-1); break; }
+            if (at > 0.75f) { owner->step(1); break; }
+        }
+        owner->choose();
+        break;
+    }
+    case EventType::Focus: {
+        bool active = std::get<EventFocus>(e.variant).active;
+        owner->focused = active;
+        owner->set_row_lit(active);
+        set_border_color(active ? theme::color::SecondaryL : theme::color::BorderSoft);
+        config::set_accept_hint(active && owner->confirm ? "Choose" : "");
+        if (active) {
+            owner->on_hover(owner->option_id);
+        }
+        else if (owner->confirm && config::get_option_browse(owner->config->id, owner->option_id) && browse_left_callback()) {
+            browse_left_callback()(owner->config->id, owner->option_id);
+        }
+        owner->refresh();
+        break;
+    }
+    case EventType::Enable: {
+        bool on = std::get<EventEnable>(e.variant).active;
+        set_focusable(on);
+        set_cursor(on ? Cursor::Pointer : Cursor::None);
+        break;
+    }
+    default:
+        break;
+    }
+}
