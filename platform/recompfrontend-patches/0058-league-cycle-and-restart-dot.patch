+    bool confirm = false;
+    bool focused = false;
+    std::string shown;
+    int shown_state = -1;  // 0 chosen, 1 browsing
+    std::string key() const;
+    std::string current_value();  // what the row shows: the browse, else the option's value
+    void step(int dir);
+    void choose();
+    void refresh();
+    void process_event(const Event &e) override;
+
+    std::string_view get_type_name() override { return "ConfigOptionCycle"; }
