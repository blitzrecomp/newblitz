diff --git a/recompui/src/base/ui_state.cpp b/recompui/src/base/ui_state.cpp
index dc8e41a..31818af 100644
--- a/recompui/src/base/ui_state.cpp
+++ b/recompui/src/base/ui_state.cpp
@@ -692,6 +692,27 @@ void draw_hook(plume::RenderCommandList* command_list, plume::RenderFramebuffer*
     bool all_input_is_disabled = recompinput::all_input_disabled();
 
     while (recompui::try_deque_event(cur_event)) {
+        // BlitzRecomp: SDL gives mouse positions (and the mouse events it makes from touches) in window points, but the
+        // UI context is sized in pixels. They're the same on a Mac without Retina mode or on Windows; an iPhone has 3
+        // pixels per point, so a tap landed a third of the way to the top-left corner and missed every button.
+        if (cur_event.type == SDL_MOUSEMOTION || cur_event.type == SDL_MOUSEBUTTONDOWN || cur_event.type == SDL_MOUSEBUTTONUP) {
+            int points_w = 0, points_h = 0, pixels_w = 0, pixels_h = 0;
+            SDL_GetWindowSize(window, &points_w, &points_h);
+            SDL_GetWindowSizeInPixels(window, &pixels_w, &pixels_h);
+            if (points_w > 0 && points_h > 0 && (pixels_w != points_w || pixels_h != points_h)) {
+                float sx = (float)pixels_w / points_w, sy = (float)pixels_h / points_h;
+                if (cur_event.type == SDL_MOUSEMOTION) {
+                    cur_event.motion.x = (Sint32)(cur_event.motion.x * sx);
+                    cur_event.motion.y = (Sint32)(cur_event.motion.y * sy);
+                    cur_event.motion.xrel = (Sint32)(cur_event.motion.xrel * sx);
+                    cur_event.motion.yrel = (Sint32)(cur_event.motion.yrel * sy);
+                }
+                else {
+                    cur_event.button.x = (Sint32)(cur_event.button.x * sx);
+                    cur_event.button.y = (Sint32)(cur_event.button.y * sy);
+                }
+            }
+        }
         bool context_capturing_input = recompui::is_context_capturing_input();
         bool context_capturing_mouse = recompui::is_context_capturing_mouse();
 
