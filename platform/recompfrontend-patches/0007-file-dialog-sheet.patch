 namespace recompui::file {
+    void apple::open_panel(bool multiple, std::function<void(bool success, const std::vector<std::filesystem::path>& paths)> callback) {
+        dispatch_async(dispatch_get_main_queue(), ^{
+            NSOpenPanel* panel = [NSOpenPanel openPanel];
+            [panel setCanChooseFiles:YES];
+            [panel setCanChooseDirectories:NO];
+            [panel setAllowsMultipleSelection:multiple ? YES : NO];
+            [NSApp activateIgnoringOtherApps:YES];
+            auto cb = callback;  // copied into the block
+            void (^done)(NSModalResponse) = ^(NSModalResponse result) {
+                std::vector<std::filesystem::path> paths;
+                if (result == NSModalResponseOK) {
+                    for (NSURL* url in [panel URLs]) {
+                        if ([url isFileURL] && [url path] != nil) paths.emplace_back([[url path] UTF8String]);
+                    }
+                }
+                bool ok = result == NSModalResponseOK && !paths.empty();
+                // A pass later, so the panel is gone before the import (or a message box) runs.
+                dispatch_async(dispatch_get_main_queue(), ^{ cb(ok, paths); });
+            };
+            // A sheet on the game window: it stays the key window while it's up (a free-standing panel could
+            // lose key status to the game window, and then took no keys).
+            NSWindow* parent = [NSApp keyWindow] ?: [NSApp mainWindow] ?: [[NSApp windows] firstObject];
+            if (parent != nil && ![parent isKindOfClass:[NSPanel class]]) {
+                [panel beginSheetModalForWindow:parent completionHandler:done];
+            } else {
+                [panel beginWithCompletionHandler:done];
+                [panel makeKeyAndOrderFront:nil];
+            }
+        });
+    }
