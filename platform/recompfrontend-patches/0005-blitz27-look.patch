+bool Element::focus_first_focusable(bool skip_text_inputs) {
+    for (auto child : children) {
+        if (!child->base->IsVisible() || !child->enabled) {
+            continue;
+        }
+        CanFocus res = child->is_focusable();
+        if (res == CanFocus::Yes) {
+            if (skip_text_inputs && (child->base->GetTagName() == "input" || child->base->GetTagName() == "textarea")) {
+                continue;
+            }
+            if (child->focus()) {
+                return true;
+            }
+            continue;
+        }
+        if (res == CanFocus::NoAndNoChildren) {
+            continue;
+        }
+        if (child->focus_first_focusable(skip_text_inputs)) {
+            return true;
+        }
+    }
+    return false;
