+void recompui::set_prompt_scoreline(const std::string &summary) {
+    std::lock_guard lock{ prompt_state.mutex };
+    ContextId prev_context = try_close_current_context();
+    prompt_state.ui_context.open();
+    prompt_state.score_line1->clear_children();
+    if (summary.empty()) {
+        prompt_state.score_plate->set_display(Display::None);
+    } else {
+        size_t comma = summary.find(", ");
+        std::string line1 = comma == std::string::npos ? summary : summary.substr(0, comma);
+        std::string line2 = comma == std::string::npos ? "" : summary.substr(comma + 2);
+        // "ARI 7 - 0 CHI": the teams in Text, the score between them in Blitz yellow.
+        size_t first_space = line1.find(' '), last_space = line1.rfind(' ');
+        auto add = [&](const std::string &text, recompui::theme::color color) {
+            auto label = prompt_state.ui_context.create_element<Label>(prompt_state.score_line1, text, theme::Typography::LabelMD);
+            label->set_font_size(54.0f);
+            label->set_color(color);
+            label->set_white_space(WhiteSpace::Nowrap);
+        };
+        if (first_space != std::string::npos && last_space > first_space) {
+            add(line1.substr(0, first_space), theme::color::Text);
+            add(line1.substr(first_space + 1, last_space - first_space - 1), theme::color::Secondary);
+            add(line1.substr(last_space + 1), theme::color::Text);
+        } else {
+            add(line1, theme::color::Text);
+        }
+        prompt_state.score_line2->set_text(line2);
+        prompt_state.score_line2->set_display(line2.empty() ? Display::None : Display::Block);
+        prompt_state.score_plate->set_display(Display::Flex);
+    }
+    prompt_state.ui_context.close();
+    if (prev_context != ContextId::null()) {
+        prev_context.open();
+    }
+}
+
 bool recompui::is_prompt_open() {
     std::lock_guard lock{ prompt_state.mutex };
 
