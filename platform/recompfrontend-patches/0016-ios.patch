+// BlitzRecomp: iOS picks files with the system document picker (the Files sheet). The picked files are copies in
+// the app's sandbox, so the import reads them like any local file.
+@interface RecompDocumentPicker : NSObject <UIDocumentPickerDelegate>
+@property(nonatomic, copy) void (^done)(NSArray<NSURL*>* urls);
+@end
+
+@implementation RecompDocumentPicker
+- (void)documentPicker:(UIDocumentPickerViewController*)controller didPickDocumentsAtURLs:(NSArray<NSURL*>*)urls {
+    if (self.done) self.done(urls);
+    self.done = nil;
+}
+- (void)documentPickerWasCancelled:(UIDocumentPickerViewController*)controller {
+    if (self.done) self.done(@[]);
+    self.done = nil;
+}
+@end
