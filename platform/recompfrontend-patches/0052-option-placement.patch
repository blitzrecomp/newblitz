+namespace {
+    std::map<std::string, std::vector<PlacedOption>> &placements() {
+        static std::map<std::string, std::vector<PlacedOption>> by_tab;
+        return by_tab;
+    }
+    std::map<std::string, std::string> &placed_tab_of() {  // "config/option" -> the tab it's drawn on
+        static std::map<std::string, std::string> tabs;
+        return tabs;
+    }
+}
+
+void config::place_option(const std::string &config_id, const std::string &option_id, const std::string &tab_id, bool first) {
+    const std::string key = config_id + "/" + option_id;
+    if (auto it = placed_tab_of().find(key); it != placed_tab_of().end()) {  // placed again: moved from the earlier tab
+        auto &old = placements()[it->second];
+        old.erase(std::remove_if(old.begin(), old.end(), [&](const PlacedOption &p) {
+            return p.config_id == config_id && p.option_id == option_id;
+        }), old.end());
+        placed_tab_of().erase(it);
+    }
+    if (tab_id == config_id) {
+        return;  // back on its own tab
+    }
+    placed_tab_of()[key] = tab_id;
+    placements()[tab_id].push_back({ config_id, option_id, first });
+}
+
+const std::vector<PlacedOption> &placed_options(const std::string &tab_id) {
+    static const std::vector<PlacedOption> none;
+    auto it = placements().find(tab_id);
+    return it == placements().end() ? none : it->second;
+}
+
+bool option_placed_elsewhere(const std::string &config_id, const std::string &option_id) {
+    return placed_tab_of().contains(config_id + "/" + option_id);
+}
+
+ConfigOptionElement *create_option_row(ContextId context, Element *parent, recomp::config::Config *config, size_t i,
+                                       set_option_value_t set_value, on_option_hover_t on_hover) {
+    const auto &config_option = config->get_config_schema().options[i];
+    ConfigOptionElement *element = nullptr;
+    const std::string key = config->id + "/" + config_option.id;
+    if (auto section = option_sections().find(key); section != option_sections().end()) {
+        context.create_element<ConfigSectionRow>(parent, section->second.label, section->second.count);
+    }
+    if (auto action = option_actions().find(key); action != option_actions().end() &&
+        config_option.type == recomp::config::ConfigOptionType::Bool) {
+        element = context.create_element<ConfigOptionAction>(parent, config_option.id, i, config, set_value, on_hover, action->second);
+    }
+    else {
+        switch (config_option.type) {
+            case recomp::config::ConfigOptionType::Enum:
+                element = context.create_element<ConfigOptionEnum>(parent, config_option.id, i, config, set_value, on_hover);
+                break;
+            case recomp::config::ConfigOptionType::Number:
+                element = context.create_element<ConfigOptionNumber>(parent, config_option.id, i, config, set_value, on_hover);
+                break;
+            case recomp::config::ConfigOptionType::String:
+                element = context.create_element<ConfigOptionString>(parent, config_option.id, i, config, set_value, on_hover);
+                break;
+            case recomp::config::ConfigOptionType::Bool:
+                element = context.create_element<ConfigOptionBool>(parent, config_option.id, i, config, set_value, on_hover);
+                break;
+            default:
+                assert(false && "Unknown config option type");
+                return nullptr;
+        }
+    }
+    element->update_disabled();
+    element->update_hidden();
+    return element;
+}
+
+size_t PlacedOptionRows::render(ContextId context, Element *parent, const std::string &tab_id, bool first, hover_t on_hover) {
+    size_t drawn = 0;
+    for (const PlacedOption &p : placed_options(tab_id)) {
+        if (p.first != first) {
+            continue;
+        }
+        recomp::config::Config *cfg = nullptr;
+        try {
+            cfg = &config::get_config(p.config_id);
+        } catch (const std::exception &) {
+            continue;  // that config's tab isn't in this build
+        }
+        const auto &by_id = cfg->get_config_schema().options_by_id;
+        auto found = by_id.find(p.option_id);
+        if (found == by_id.end()) {
+            continue;
+        }
+        const size_t index = found->second;
+        // Its own config's change, saved at once: its own tab's close (which saves it) may not come.
+        set_option_value_t set_value = [cfg](const std::string &option_id, recomp::config::ConfigValueVariant value) {
+            cfg->set_option_value(option_id, value);
+            if (!cfg->requires_confirmation) {
+                cfg->save_config();
+            }
+        };
+        on_option_hover_t hover = [cfg, on_hover](const std::string &option_id) {
+            if (on_hover) {
+                on_hover(cfg, option_id);
+            }
+        };
+        ConfigOptionElement *element = create_option_row(context, parent, cfg, index, set_value, hover);
+        if (element == nullptr) {
+            continue;
+        }
+        rows.push_back({ element, cfg, index, cfg->is_config_option_hidden(index), cfg->is_config_option_disabled(index),
+                         cfg->requires_confirmation ? cfg->get_temp_option_value(p.option_id) : cfg->get_option_value(p.option_id) });
+        drawn++;
+    }
+    return drawn;
+}
+
+void PlacedOptionRows::poll() {
+    for (Row &row : rows) {
+        const bool hidden = row.config->is_config_option_hidden(row.index);
+        if (hidden != row.hidden) {
+            row.hidden = hidden;
+            row.element->update_hidden();
+        }
+        const bool disabled = row.config->is_config_option_disabled(row.index);
+        if (disabled != row.disabled) {
+            row.disabled = disabled;
+            row.element->update_disabled();
+        }
+        const std::string &id = row.element->get_option_id();
+        recomp::config::ConfigValueVariant value =
+            row.config->requires_confirmation ? row.config->get_temp_option_value(id) : row.config->get_option_value(id);
+        if (value != row.value) {
+            row.value = value;
+            row.element->update_value();
+        }
+    }
+}
