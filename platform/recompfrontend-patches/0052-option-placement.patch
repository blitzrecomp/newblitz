diff --git a/recompui/src/config/ui_config_placed_rows.h b/recompui/src/config/ui_config_placed_rows.h
new file mode 100644
index 0000000..f782411
--- /dev/null
+++ b/recompui/src/config/ui_config_placed_rows.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <functional>
+#include <string>
+#include <vector>
+
+#include "config/ui_config_option.h"
+#include "librecomp/config.hpp"
+
+namespace recompui {
+    // Blitz settings layout (config::place_option): rows drawn on another tab than their config's own. Each keeps its
+    // config, so its value is read from and written to that config (and its file) as on its own tab.
+    struct PlacedOption {
+        std::string config_id;
+        std::string option_id;
+        bool first = false;
+    };
+    const std::vector<PlacedOption> &placed_options(const std::string &tab_id);
+    bool option_placed_elsewhere(const std::string &config_id, const std::string &option_id);
+    // One option's row (and the section heading set before it), as an options page draws it.
+    ConfigOptionElement *create_option_row(ContextId context, Element *parent, recomp::config::Config *config, size_t option_index,
+                                           set_option_value_t set_value, on_option_hover_t on_hover);
+
+    // The rows placed on a tab, drawn into a page and kept up to date by polling (their configs' update lists belong to
+    // their own pages).
+    class PlacedOptionRows {
+    public:
+        using hover_t = std::function<void(recomp::config::Config *config, const std::string &option_id)>;
+        void clear() { rows.clear(); }
+        bool empty() const { return rows.empty(); }
+        // Draws the rows placed on tab_id with this `first`, in the order placed. Returns how many it drew.
+        size_t render(ContextId context, Element *parent, const std::string &tab_id, bool first, hover_t on_hover);
+        // Each update: a row whose value, hidden or disabled state changed is redrawn.
+        void poll();
+    private:
+        struct Row {
+            ConfigOptionElement *element;
+            recomp::config::Config *config;
+            size_t index;
+            bool hidden, disabled;
+            recomp::config::ConfigValueVariant value;
+        };
+        std::vector<Row> rows;
+    };
+}
