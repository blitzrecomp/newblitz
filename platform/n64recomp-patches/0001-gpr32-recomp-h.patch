+// BlitzRecomp: no 128-bit type (a 32-bit compiler such as psp-gcc): 64x64 -> 128 by 32-bit halves.
+static inline void DMULTU(uint64_t a, uint64_t b, uint64_t* lo64, uint64_t* hi64) {
+    uint64_t al = (uint32_t)a, ah = a >> 32, bl = (uint32_t)b, bh = b >> 32;
+    uint64_t p0 = al * bl, p1 = al * bh, p2 = ah * bl, p3 = ah * bh;
+    uint64_t mid = (p0 >> 32) + (uint32_t)p1 + (uint32_t)p2;
+    *lo64 = (mid << 32) | (uint32_t)p0;
+    *hi64 = p3 + (p1 >> 32) + (p2 >> 32) + (mid >> 32);
+}
+
+static inline void DMULT(int64_t a, int64_t b, int64_t* lo64, int64_t* hi64) {
+    // The signed product's high half is the unsigned one less b for a negative a and a for a negative b.
+    uint64_t lo, hi;
+    DMULTU((uint64_t)a, (uint64_t)b, &lo, &hi);
+    if (a < 0) hi -= (uint64_t)b;
+    if (b < 0) hi -= (uint64_t)a;
+    *lo64 = (int64_t)lo;
+    *hi64 = (int64_t)hi;
+}
 #endif
 
