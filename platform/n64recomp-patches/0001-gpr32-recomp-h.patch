+// BlitzRecomp: 32-bit registers (the PSP port, docs/PSP_PORT.md section 3). With RECOMP_GPR32 defined, a gpr is
+// the low 32 bits of the MIPS register rather than its 64-bit sign extension. The game uses no 64-bit integer
+// instruction (tools/psp/gpr32.py fails the build if one appears), so every register's upper half is a copy of
+// bit 31 and 32 bits carry the same information. RECOMP_GPR32 changes recomp_context's layout, so it must be
+// defined for every translation unit. Without it this header is the stock one.
+#if defined(RECOMP_GPR32)
+
+typedef uint32_t gpr;
+
+#define SIGNED(val) \
+    ((int32_t)(val))
+
+#define ADD32(a, b) \
+    ((gpr)(int32_t)((a) + (b)))
+
+#define SUB32(a, b) \
+    ((gpr)(int32_t)((a) - (b)))
+
+// A guest address to an offset into rdram. RECOMP_RDRAM_MASK (the PSP: 8 MB of RDRAM, a power of two) folds
+// KSEG0, KSEG1 and physical addresses onto RDRAM, so no access can land outside it. Without the mask the offset
+// is the 64-bit build's own, for every 32-bit address (validation on a 64-bit host).
+#ifndef RDRAM_OFF
+#  ifdef RECOMP_RDRAM_MASK
+#    define RDRAM_OFF(addr) ((uint32_t)(addr) & 0x007FFFFFu)
+#  else
+#    define RDRAM_OFF(addr) ((uint32_t)(addr) - 0x80000000u)
+#  endif
+#endif
+
+#define MEM_W(offset, reg) \
+    (*(int32_t*)(rdram + RDRAM_OFF((reg) + (offset))))
+
+#define MEM_H(offset, reg) \
+    (*(int16_t*)(rdram + RDRAM_OFF(((reg) + (offset)) ^ 2)))
+
+#define MEM_B(offset, reg) \
+    (*(int8_t*)(rdram + RDRAM_OFF(((reg) + (offset)) ^ 3)))
+
+#define MEM_HU(offset, reg) \
+    (*(uint16_t*)(rdram + RDRAM_OFF(((reg) + (offset)) ^ 2)))
+
+#define MEM_BU(offset, reg) \
+    (*(uint8_t*)(rdram + RDRAM_OFF(((reg) + (offset)) ^ 3)))
+
+// sdc1 is the only doubleword store left (an fpr's 64 bits). The stock macro's (gpr)(val) >> 32 would drop the
+// high word with a 32-bit gpr.
+#define SD(val, offset, reg) { \
+    *(uint32_t*)(rdram + RDRAM_OFF((reg) + (offset) + 4)) = (uint32_t)((uint64_t)(val) >> 0); \
+    *(uint32_t*)(rdram + RDRAM_OFF((reg) + (offset) + 0)) = (uint32_t)((uint64_t)(val) >> 32); \
+}
+
+// MIPS div (VR4300 results): x / 0 gives lo = x < 0 ? 1 : -1, hi = x; INT_MIN / -1 gives lo = INT_MIN, hi = 0.
+// gpr32.py rewrites the generator's 64-bit division into this, so a 32-bit host divides in one instruction
+// and never meets C's undefined cases.
+#define DIV32(a, b, lo_out, hi_out) do { \
+    int32_t _a = (int32_t)(a), _b = (int32_t)(b); \
+    if (_b == 0)       { *(lo_out) = (_a < 0) ? 1u : 0xFFFFFFFFu; *(hi_out) = (uint32_t)_a; } \
+    else if (_b == -1) { *(lo_out) = 0u - (uint32_t)_a; *(hi_out) = 0u; } \
+    else               { *(lo_out) = (uint32_t)(_a / _b); *(hi_out) = (uint32_t)(_a % _b); } \
+} while (0)
