+        // Potato Mode: the driver's compiled pipelines, kept between launches (a weak CPU spends a minute on them).
+        if (const char *folder = (getenv("BLITZ_LEAN") != nullptr) ? getenv("APP_FOLDER_PATH") : nullptr) {
