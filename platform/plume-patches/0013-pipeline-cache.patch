+    void VulkanDevice::savePipelineCache() {
+        if (pipelineCache == VK_NULL_HANDLE) {
+            return;
+        }
+
+        size_t size = 0;
+        if ((vkGetPipelineCacheData(vk, pipelineCache, &size, nullptr) != VK_SUCCESS) || (size == 0)) {
+            return;
+        }
+
+        std::vector<char> data(size);
+        if (vkGetPipelineCacheData(vk, pipelineCache, &size, data.data()) != VK_SUCCESS) {
+            return;
+        }
+
+        const std::string temporary = pipelineCachePath + ".new";
+        if (FILE *f = fopen(temporary.c_str(), "wb")) {
+            const bool written = fwrite(data.data(), 1, size, f) == size;
+            fclose(f);
+            if (written) {
+                rename(temporary.c_str(), pipelineCachePath.c_str());
+                fprintf(stderr, "[vulkan] pipeline cache saved: %zu KB\n", size / 1024);
+            }
+        }
+    }
