 #include "plume_apple.h"
 
+#include <TargetConditionals.h>
+#if TARGET_OS_IPHONE
+// BlitzRecomp: iOS (UIKit). The window is the app's UIWindow (SDL's, in the app's window scene); its size is the
+// drawable's in pixels (bounds x native scale); no fullscreen to toggle; the GPU is Apple's.
+#import <UIKit/UIKit.h>
+#import <Foundation/Foundation.h>
+
+namespace plume {
+    RenderDeviceVendor getRenderDeviceVendor(uint64_t) {
+        return RenderDeviceVendor::APPLE;
+    }
+
+    static CocoaWindowAttributes uikitAttributes(void *handle) {
+        UIWindow *window = (__bridge UIWindow *)handle;
+        CGRect bounds = window.bounds;
+        CGFloat scale = window.screen.nativeScale;
+        return CocoaWindowAttributes{0, 0, (int)round(bounds.size.width * scale), (int)round(bounds.size.height * scale)};
+    }
+
+    CocoaWindow::CocoaWindow(void *window) : windowHandle(window), cachedRefreshRate(0) {
+        cachedAttributes = {0, 0, 0, 0};
+        if ([NSThread isMainThread]) {
+            cachedAttributes = uikitAttributes(windowHandle);
+            cachedRefreshRate.store((int)((__bridge UIWindow *)windowHandle).screen.maximumFramesPerSecond);
+        } else {
+            updateWindowAttributesInternal(true);
+            updateRefreshRateInternal(true);
+        }
+    }
+
+    CocoaWindow::~CocoaWindow() {}
+
+    void CocoaWindow::updateWindowAttributesInternal(bool forceSync) {
+        auto updateBlock = ^{
+            CocoaWindowAttributes fresh = uikitAttributes(windowHandle);
+            std::lock_guard<std::mutex> lock(attributesMutex);
+            cachedAttributes = fresh;
+        };
+        if (forceSync) dispatch_sync(dispatch_get_main_queue(), updateBlock);
+        else dispatch_async(dispatch_get_main_queue(), updateBlock);
+    }
+
+    void CocoaWindow::updateRefreshRateInternal(bool forceSync) {
+        auto updateBlock = ^{
+            cachedRefreshRate.store((int)((__bridge UIWindow *)windowHandle).screen.maximumFramesPerSecond);
+        };
+        if (forceSync) dispatch_sync(dispatch_get_main_queue(), updateBlock);
+        else dispatch_async(dispatch_get_main_queue(), updateBlock);
+    }
+
+    void CocoaWindow::getWindowAttributes(CocoaWindowAttributes *attributes) const {
+        if ([NSThread isMainThread]) {
+            CocoaWindowAttributes fresh = uikitAttributes(windowHandle);
+            std::lock_guard<std::mutex> lock(attributesMutex);
+            const_cast<CocoaWindow *>(this)->cachedAttributes = fresh;
+            *attributes = fresh;
+        } else {
+            {
+                std::lock_guard<std::mutex> lock(attributesMutex);
+                *attributes = cachedAttributes;
+            }
+            const_cast<CocoaWindow *>(this)->updateWindowAttributesInternal(false);
+        }
+    }
+
+    int CocoaWindow::getRefreshRate() const {
+        int rate = cachedRefreshRate.load();
+        const_cast<CocoaWindow *>(this)->updateRefreshRateInternal(false);
+        return rate;
+    }
+
+    void CocoaWindow::setFullscreen(bool) {}
+    void CocoaWindow::toggleFullscreen() {}
+}
+#else
+
+
 #import <AppKit/AppKit.h>
 #import <Foundation/Foundation.h>
 #import <IOKit/IOKitLib.h>
