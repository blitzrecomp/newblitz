+    // Compact textures: the shaders declare 8192 of each, and an array in a shader can't be longer than its binding in the
+    // layout, so cut the 2D and the 1D (TMEM) arrays to the plain sizes of the layouts. The length 8192 may have other uses, so
+    // each array gets a new constant rather than the old one changing.
+    static void withShortTextureArrays(std::vector<uint32_t> &code, uint32_t textures2D, uint32_t texturesTMEM) {
+        if (code.size() < 5) {
+            return;
+        }
+
+        struct Constant {
+            uint32_t type;
+            uint32_t value;
+        };
+
+        std::unordered_map<uint32_t, Constant> constants;
+        std::unordered_map<uint32_t, uint32_t> imageDims;
+        std::vector<uint32_t> out(code.begin(), code.begin() + 5);
+        out.reserve(code.size() + 8);
+        uint32_t bound = code[3];
+        uint32_t length2D = 0;
+        uint32_t lengthTMEM = 0;
+        for (size_t i = 5; i < code.size(); ) {
+            const uint32_t opcode = code[i] & 0xFFFF;
+            const uint32_t length = code[i] >> 16;
+            if ((length == 0) || (i + length > code.size())) {
+                return;  // not what we thought: leave it as it came
+            }
+
+            bool shortened = false;
+            if ((opcode == 43) && (length == 4)) {  // OpConstant: type, result, value
+                constants[code[i + 2]] = Constant{ code[i + 1], code[i + 3] };
+            }
+            else if ((opcode == 25) && (length >= 4)) {  // OpTypeImage: result, sampled type, dim (0 is 1D, 1 is 2D)
+                imageDims[code[i + 1]] = code[i + 3];
+            }
+            else if ((opcode == 28) && (length == 4)) {  // OpTypeArray: result, element, length
+                const auto image = imageDims.find(code[i + 2]);
+                const auto constant = constants.find(code[i + 3]);
+                if ((image != imageDims.end()) && (constant != constants.end()) && (constant->second.value == 8192) && (image->second <= 1)) {
+                    const bool tmem = (image->second == 0);
+                    uint32_t &lengthId = tmem ? lengthTMEM : length2D;
+                    if (lengthId == 0) {
+                        lengthId = bound++;
+                        out.push_back((4U << 16) | 43U);
+                        out.push_back(constant->second.type);
+                        out.push_back(lengthId);
+                        out.push_back(tmem ? texturesTMEM : textures2D);
+                    }
+
+                    out.push_back(code[i]);
+                    out.push_back(code[i + 1]);
+                    out.push_back(code[i + 2]);
+                    out.push_back(lengthId);
+                    shortened = true;
+                }
+            }
+
+            if (!shortened) {
+                out.insert(out.end(), code.begin() + i, code.begin() + i + length);
+            }
+            i += length;
+        }
+
+        out[3] = bound;
+        code.swap(out);
+    }
