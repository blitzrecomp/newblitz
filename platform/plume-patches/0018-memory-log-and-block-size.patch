+    // Potato Mode (BLITZ_LEAN) or BLITZ_VMA_LOG: where the GPU memory goes. Allocations of 512 KB or more as they're made, and
+    // VMA's totals every 10 s from present: what its blocks hold against what they reserve.
+    static bool blitzMemoryLog() {
+        static const bool on = (getenv("BLITZ_LEAN") != nullptr) || (getenv("BLITZ_VMA_LOG") != nullptr);
+        return on;
+    }
+
+    static void blitzNoteAllocation(const char *kind, VkDeviceSize size, uint32_t a, uint32_t b, uint32_t c, uint32_t memoryType, bool dedicated) {
+        static std::atomic<int> lines{ 0 };
+        if (!blitzMemoryLog() || (size < (512 * 1024)) || (lines.fetch_add(1) >= 400)) {
+            return;
+        }
+
+        fprintf(stderr, "[vulkan] alloc %s %llu KB (%u %u %u), memory type %u%s\n", kind, (unsigned long long)(size >> 10), a, b, c, memoryType, dedicated ? ", dedicated" : "");
+    }
+
+    static void blitzReportMemory(VmaAllocator allocator, const char *why) {
+        VmaTotalStatistics stats = {};
+        vmaCalculateStatistics(allocator, &stats);
+        const VmaStatistics &t = stats.total.statistics;
+        fprintf(stderr, "[vulkan] memory (%s): %u blocks %llu KB, %u allocations %llu KB, %llu KB reserved but unused.", why, t.blockCount,
+            (unsigned long long)(t.blockBytes >> 10), t.allocationCount, (unsigned long long)(t.allocationBytes >> 10), (unsigned long long)((t.blockBytes - t.allocationBytes) >> 10));
+        for (uint32_t i = 0; i < VK_MAX_MEMORY_TYPES; i++) {
+            const VmaStatistics &m = stats.memoryType[i].statistics;
+            if (m.blockBytes > 0) {
+                fprintf(stderr, " Type %u: %u blocks %llu KB, %u allocations %llu KB.", i, m.blockCount, (unsigned long long)(m.blockBytes >> 10), m.allocationCount, (unsigned long long)(m.allocationBytes >> 10));
+            }
+        }
+
+        fprintf(stderr, "\n");
+    }
