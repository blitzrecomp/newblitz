+// VMA's block size in MB, 0 for VMA's own: BLITZ_VMA_BLOCK_MB, or 4 in Potato Mode (BLITZ_LEAN). VMA takes a heap of 1 GB or less as
+// small and makes its blocks an eighth of it whatever size is asked (128 MB on a 1 GB phone, each memory type with its own), so
+// with a size asked no heap counts as small. Measured on an RG DS (Mali-G52, 950 MB): 167 MB of blocks held 45 MB of allocations
+// with VMA's own; 47 MB with 4 MB blocks.
+static int blitzVmaBlockMB() {
+    const char *blockMB = getenv("BLITZ_VMA_BLOCK_MB");
+    if (blockMB != nullptr) {
+        return std::max(atoi(blockMB), 0);
+    }
+
+    return (getenv("BLITZ_LEAN") != nullptr) ? 4 : 0;
+}
+
+static unsigned long long blitzVmaSmallHeapMax() {
+    return (blitzVmaBlockMB() > 0) ? 0ull : (1024ull * 1024 * 1024);
+}
+
+#define VMA_SMALL_HEAP_MAX_SIZE (blitzVmaSmallHeapMax())
+
