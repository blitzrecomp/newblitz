+    void CocoaWindow::setFullscreen(bool fullscreen) {
+        void *handle = windowHandle;
+        void (^apply)(void) = ^{
+            NSWindow *nsWindow = (__bridge NSWindow *)handle;
+            bool now = ([nsWindow styleMask] & NSWindowStyleMaskFullScreen) != 0;
+            if (now != fullscreen) {
+                [nsWindow toggleFullScreen:NULL];
+            }
+        };
+        if ([NSThread isMainThread]) {
+            apply();
+        } else {
+            dispatch_async(dispatch_get_main_queue(), apply);
+        }
+    }
+
