 #include "plume_vulkan.h"
 
 #include <algorithm>
+#include <atomic>
 #include <cmath>
 #include <climits>
 #include <unordered_map>
@@ -2186,6 +2187,60 @@ namespace plume {
 
     // VulkanSwapChain
 
+#   if defined(__ANDROID__)
+    // BlitzRecomp: Android replaces the app's window (its ANativeWindow) when the app goes to the background and comes
+    // back. The app reports the current one (nullptr while backgrounded) with plume_android_set_window; a swap chain
+    // that sees it change rebuilds its surface on the new window at its next resize.
+    static std::atomic<ANativeWindow *> androidCurrentWindow{ nullptr };
+    static std::atomic<bool> androidWindowReported{ false };
+
+    static VkResult createAndroidSurface(VkInstance instance, ANativeWindow *window, VkSurfaceKHR *surface) {
+        VkAndroidSurfaceCreateInfoKHR surfaceCreateInfo = {};
+        surfaceCreateInfo.sType = VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR;
+        surfaceCreateInfo.window = window;
+        return vkCreateAndroidSurfaceKHR(instance, &surfaceCreateInfo, nullptr, surface);
+    }
+
+    // True when the swap chain's surface is on the current window (rebuilding it first if the window changed).
+    bool VulkanSwapChain::refreshAndroidSurface() {
+        if (!androidWindowReported.load()) {
+            return surface != VK_NULL_HANDLE;
+        }
+
+        ANativeWindow *current = androidCurrentWindow.load();
+        if (current == desc.renderWindow) {
+            return (current != nullptr) && (surface != VK_NULL_HANDLE);
+        }
+
+        VulkanInterface *renderInterface = commandQueue->device->renderInterface;
+        releaseImageViews();
+        releaseSwapChain();
+        if (surface != VK_NULL_HANDLE) {
+            vkDestroySurfaceKHR(renderInterface->instance, surface, nullptr);
+            surface = VK_NULL_HANDLE;
+        }
+
+        if (desc.renderWindow != nullptr) {
+            ANativeWindow_release(desc.renderWindow);
+        }
+
+        desc.renderWindow = current;
+        if (current == nullptr) {
+            return false;
+        }
+
+        ANativeWindow_acquire(current);
+        VkResult res = createAndroidSurface(renderInterface->instance, current, &surface);
+        if (res != VK_SUCCESS) {
+            fprintf(stderr, "vkCreateAndroidSurfaceKHR failed with error code 0x%X.\n", res);
+            surface = VK_NULL_HANDLE;
+            return false;
+        }
+
+        return true;
+    }
+#   endif
+
     VulkanSwapChain::VulkanSwapChain(VulkanCommandQueue *commandQueue, const RenderSwapChainDesc &desc) {
         assert(commandQueue != nullptr);
         assert(desc.textureCount > 0);
