+        }
+#   endif
+
         // Remove tracking from the parent command queue.
         commandQueue->swapChains.erase(this);
     }
@@ -2430,6 +2488,11 @@ namespace plume {
     }
 
     bool VulkanSwapChain::resize() {
+#   if defined(__ANDROID__)
+        if (!refreshAndroidSurface()) {
+            return false;  // backgrounded: no window to draw to until the app comes back
+        }
+#   endif
         getWindowSize(width, height);
 
         // Don't recreate the swap chain at all if the window doesn't have a valid size.
@@ -2530,6 +2593,15 @@ namespace plume {
     }
 
     bool VulkanSwapChain::needsResize() const {
+#   if defined(__ANDROID__)
+        if (androidWindowReported.load() && (androidCurrentWindow.load() != desc.renderWindow)) {
+            return true;
+        }
+
+        if (desc.renderWindow == nullptr) {
+            return true;
+        }
+#   endif
         uint32_t windowWidth, windowHeight;
         getWindowSize(windowWidth, windowHeight);
         return (vk == VK_NULL_HANDLE) || (windowWidth != width) || (windowHeight != height) || (requiredPresentMode != createdPresentMode);
@@ -4794,3 +4866,11 @@ namespace plume {
     }
 #endif
 };
+
+#if defined(__ANDROID__)
+// BlitzRecomp: the app's current window (SDL's ANativeWindow), or nullptr while the app is in the background.
+extern "C" void plume_android_set_window(ANativeWindow *window) {
+    plume::androidCurrentWindow.store(window);
+    plume::androidWindowReported.store(true);
+}
+#endif
