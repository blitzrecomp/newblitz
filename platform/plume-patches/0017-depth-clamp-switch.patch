         rasterization.rasterizerDiscardEnable = VK_FALSE;
         rasterization.polygonMode = VK_POLYGON_MODE_FILL;
         rasterization.lineWidth = 1.0f;
@@ -4624,10 +4625,14 @@ namespace plume {
                 capabilities.compactTextures2D = imageBudget - capabilities.compactTexturesTMEM;
             }
 
-            fprintf(stderr, "[vulkan] textures: mode %s (asked %s), small limit %d, arrays %u 2D and %u TMEM. Per stage: %u resources, %u storage images, %u storage buffers. Depth clamp %d\n",
+            const char *clamp = getenv("BLITZ_RECIPE_DEPTHCLAMP");
+            depthClampSpec = (clamp != nullptr) ? (strcmp(clamp, "spec") == 0) : (capabilities.compactTextures2D > 0);
+            const char *evictFix = getenv("BLITZ_RECIPE_EVICTFIX");
+            fprintf(stderr, "[vulkan] textures: mode %s (asked %s), small limit %d, arrays %u 2D and %u TMEM. Per stage: %u resources, %u storage images, %u storage buffers. Depth clamp %d, without it %s. Eviction fix %s\n",
                 (capabilities.compactTextures2D > 0) ? "compact" : "legacy", (texmode != nullptr) ? texmode : "nothing", capabilities.smallTextureLimit,
                 capabilities.compactTextures2D, capabilities.compactTexturesTMEM, limits.maxPerStageResources, limits.maxPerStageDescriptorStorageImages,
-                limits.maxPerStageDescriptorStorageBuffers, deviceFeatures.features.depthClamp);
+                limits.maxPerStageDescriptorStorageBuffers, deviceFeatures.features.depthClamp, depthClampSpec ? "spec" : "legacy",
+                !capabilities.smallTextureLimit ? "not needed" : ((evictFix != nullptr) && (strcmp(evictFix, "0") == 0)) ? "off" : "on");
         }
 
         capabilities.bufferDeviceAddress = bufferDeviceAddressSupported;
