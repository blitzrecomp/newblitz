diff --git a/plume_vulkan.cpp b/plume_vulkan.cpp
index a6aca3f..95fc70b 100644
--- a/plume_vulkan.cpp
+++ b/plume_vulkan.cpp
@@ -1746,7 +1746,8 @@ namespace plume {
         VkPipelineRasterizationStateCreateInfo rasterization = {};
         rasterization.sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO;
         // Compact textures keep to the spec here too: no clamp from a driver without the feature. Legacy stays what has been measured.
-        rasterization.depthClampEnable = !desc.depthClipEnabled && (device->depthClampSupported || (device->capabilities.compactTextures2D == 0));
+        // Recipe depthclamp=spec|legacy picks either on its own, so a texmode=compact run can be told apart from this.
