--- a/plume_render_interface_types.h
+++ b/plume_render_interface_types.h
@@ -41,6 +41,23 @@ namespace plume {
     typedef ANativeWindow* RenderWindow;
 #elif defined(PLUME_SDL_VULKAN_ENABLED)
     typedef SDL_Window *RenderWindow;
+#elif defined(__PROSPERO__)
+    // PS5 homebrew (plume-ps5): no window; the swap chain draws to a display plane (VK_KHR_display).
+    struct RenderWindow {
+        void* window = nullptr;
+        uint32_t width = 3840;
+        uint32_t height = 2160;
+
+        RenderWindow() = default;
+        RenderWindow(std::nullptr_t) : window(nullptr) {}
+        RenderWindow(void* w, uint32_t width = 3840, uint32_t height = 2160)
+            : window(w), width(width), height(height) {}
+
+        bool operator==(const struct RenderWindow& rhs) const {
+            return window == rhs.window && width == rhs.width && height == rhs.height;
+        }
+        bool operator!=(const struct RenderWindow& rhs) const { return !(*this == rhs); }
+    };
 #elif defined(__linux__)
     struct RenderWindow {
         Display* display;
