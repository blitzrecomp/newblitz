<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleDisplayName</key><string>@BLITZ_BUNDLE_NAME@</string>
	<key>CFBundleExecutable</key><string>BlitzRecompiled</string>
	<key>CFBundleIdentifier</key><string>@BLITZ_IOS_BUNDLE_ID@</string>
	<key>CFBundleName</key><string>@BLITZ_BUNDLE_NAME@</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>@BLITZ_VERSION@</string>
	<key>CFBundleVersion</key><string>@BLITZ_BUILD@</string>
	<key>CFBundleSupportedPlatforms</key><array><string>iPhoneOS</string></array>
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key><array><string>AppIcon60x60</string></array>
			<key>CFBundleIconName</key><string>AppIcon</string>
		</dict>
	</dict>
	<key>DTPlatformName</key><string>iphoneos</string>
	<key>MinimumOSVersion</key><string>17.0</string>
	<key>LSRequiresIPhoneOS</key><true/>
	<key>UIDeviceFamily</key><array><integer>1</integer><integer>2</integer></array>
	<key>UIRequiredDeviceCapabilities</key><array><string>arm64</string><string>metal</string></array>
	<key>UILaunchScreen</key><dict><key>UIColorName</key><string></string></dict>
	<key>UIRequiresFullScreen</key><true/>
	<!-- ProMotion iPhones: present at the display's real rate (iOS caps apps at 60 fps without this, while the
	     screen reports 120 Hz to RT64: uneven frame pacing). -->
	<key>CADisableMinimumFrameDurationOnPhone</key><true/>
	<key>UIStatusBarHidden</key><true/>
	<key>UIViewControllerBasedStatusBarAppearance</key><false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
	</array>
	<key>UIFileSharingEnabled</key><true/>
	<key>LSSupportsOpeningDocumentsInPlace</key><true/>
	<!-- A ROM opened into the app from Files (Share → New Blitz) or another app (platform_ios.mm, scene openURLContexts).
	     Delta's N64 type is listed by its own id: with Delta installed, a .z64 is Delta's type (its exported
	     declaration wins over ours), and the share sheet offers only the apps that list that type. Alternate: never
	     the default app for these files. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key><string>N64 ROM</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>LSHandlerRank</key><string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.blitzrecomp.n64-rom</string>
				<string>com.rileytestut.delta.game.n64</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key><string>New Blitz Saves</string>
			<key>CFBundleTypeRole</key><string>Editor</string>
			<key>LSHandlerRank</key><string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.blitzrecomp.nbsave</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key><string>Zip Archive</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>LSHandlerRank</key><string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.zip-archive</string>
			</array>
		</dict>
	</array>
	<!-- Imported, not exported: the app uses these types without owning them. Ours for .z64/.n64/.v64 when no other
	     app declares one; Delta's as Delta declares it (rileytestut/Delta, Delta/Supporting Files/Info.plist), so the
	     id means the same thing to this app whether or not Delta is installed. Both conform to public.data. -->
	<!-- Save Sync's file (Settings > General > Save Sync, docs/SAVE_SYNC.md): ours, so it opens in New Blitz. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key><string>com.blitzrecomp.nbsave</string>
			<key>UTTypeDescription</key><string>New Blitz Saves</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key><array><string>nbsave</string></array>
			</dict>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key><string>com.blitzrecomp.n64-rom</string>
			<key>UTTypeDescription</key><string>N64 ROM</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key><array><string>z64</string><string>n64</string><string>v64</string></array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key><string>com.rileytestut.delta.game.n64</string>
			<key>UTTypeDescription</key><string>N64 Game</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string><string>public.content</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key><array><string>n64</string><string>z64</string></array>
			</dict>
		</dict>
	</array>
	<key>NSLocalNetworkUsageDescription</key><string>Phones on your network can join as controllers and open the Roster Room, and Sync over Wi-Fi sends your saves to your other device.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key><false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key><string>Default</string>
					<key>UISceneDelegateClassName</key><string>BlitzSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
