+/* BlitzRecomp: iOS 27 requires the scene lifecycle, and a window shows only in a window scene. The app's scene
+ * connects as the run loop turns after launch, so this waits for it (up to 3 s) when SDL is asked early. */
+UIWindowScene *UIKit_GetWindowScene(void)
+{
+    if (@available(iOS 13.0, tvOS 13.0, *)) {
+        for (int tries = 0; tries < 300; tries++) {
+            for (UIScene *scene in [UIApplication sharedApplication].connectedScenes) {
+                if ([scene isKindOfClass:[UIWindowScene class]]) {
+                    return (UIWindowScene *)scene;
+                }
+            }
+            CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.01, false);
+        }
+    }
+    return nil;
+}
