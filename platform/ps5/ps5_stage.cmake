# PS5 title folder (docs/PS5_HOMEBREW.md): what FTP copies to /data/homebrew/<title ID> on the console, mounted there
# as /app0. eboot.bin is the app itself (tools/ps5/link_title.sh links and signs it); sce_sys/ holds the home screen's
# metadata and icon, sce_module/libc.prx the runtime module titles carry (UnleashedRecomp-Prospero's runtime/libc.prx,
# generated by its tooling, no console code), and the rest is the app's resources, as on the other platforms.
if (BLITZ_MODERN_APP)
    set(BLITZ_PS5_TITLE_ID "PPSA99961")
    set(BLITZ_PS5_CONCEPT "99961")
    # BRANDING: PS5 content label
    set(BLITZ_PS5_CONTENT_LABEL "BLITZMODERN00001")
else()
    set(BLITZ_PS5_TITLE_ID "PPSA99960")
    set(BLITZ_PS5_CONCEPT "99960")
    # BRANDING: PS5 content label
    set(BLITZ_PS5_CONTENT_LABEL "BLITZCLASSIC0001")
endif()
set(BLITZ_PS5_TITLE_DIR ${CMAKE_BINARY_DIR}/${BLITZ_PS5_TITLE_ID})
set(BLITZ_PS5_UNLEASHED ${CMAKE_SOURCE_DIR}/build/ps5/deps/unleashed-prospero)

set_target_properties(BlitzRecompiled PROPERTIES
    OUTPUT_NAME "eboot.bin"
    SUFFIX ""
    RUNTIME_OUTPUT_DIRECTORY ${BLITZ_PS5_TITLE_DIR}
    RULE_LAUNCH_LINK ${CMAKE_SOURCE_DIR}/tools/ps5/link_title.sh)
target_compile_definitions(BlitzRecompiled PRIVATE SDL_MAIN_HANDLED)
configure_file(${CMAKE_SOURCE_DIR}/platform/ps5/param.json.in ${BLITZ_PS5_TITLE_DIR}/sce_sys/param.json @ONLY)

add_custom_command(TARGET BlitzRecompiled POST_BUILD
    ${BLITZ_STAGE_RESOURCES}
    COMMAND ${CMAKE_COMMAND} -E make_directory ${BLITZ_PS5_TITLE_DIR}/sce_module
    COMMAND ${CMAKE_COMMAND} -E copy ${BLITZ_PS5_UNLEASHED}/runtime/libc.prx ${BLITZ_PS5_TITLE_DIR}/sce_module/libc.prx
    # The home screen tile: 512x512 (the Mac's sips; the build runs on a Mac)
    COMMAND sips -z 512 512 ${BLITZ_APP_ICON} --out ${BLITZ_PS5_TITLE_DIR}/sce_sys/icon0.png
    COMMENT "Staging the PS5 title folder ${BLITZ_PS5_TITLE_ID}"
    VERBATIM
)
