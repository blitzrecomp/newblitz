@@ -128,6 +128,20 @@
 
 bool is_game_started();
 void quit();
+
+#if defined(ULTRAMODERN_LOCKSTEP)
+// BlitzRecomp (PSP port, psp-host --lockstep, docs/PSP_PORT.md §3.4): the game on virtual time, so two builds can be compared
+// RDRAM CRC by RDRAM CRC. Once enabled (before recomp::start), a VI happens only when the game asks for one: a game thread
+// waiting for an external message finds none queued and hands the VI thread one VI step, synchronously. RSP and RDP
+// tasks complete on the game thread at submit, and osGetCount/osGetTime count VIs (plus a fixed step per read).
+namespace lockstep {
+    void enable();
+    bool enabled();
+    uint64_t vi_count();            // VIs stepped since the game started
+    uint64_t virtual_ticks();       // osGetCount's clock: 46.875 MHz over the VIs, plus 64 ticks per read in a VI
+    void run_one_vi();              // game thread: one VI step on the VI thread, returns once it is done
+}
+#endif
 void join_event_threads();
 void join_thread_cleaner_thread();
 void join_saving_thread();
diff --git a/ultramodern/src/events.cpp b/ultramodern/src/events.cpp
--- a/ultramodern/src/events.cpp
+++ b/ultramodern/src/events.cpp
@@ -173,7 +173,26 @@
 
 uint64_t total_vis = 0;
 
+#if defined(ULTRAMODERN_LOCKSTEP)
+static std::atomic_bool lockstep_on{false};
+static ultramodern::host_sem lockstep_step_request;
+static ultramodern::host_sem lockstep_step_done;
+static std::atomic<uint64_t> lockstep_reads_in_vi{0};
 
+void ultramodern::lockstep::enable() { lockstep_on = true; }
+bool ultramodern::lockstep::enabled() { return lockstep_on.load(); }
+uint64_t ultramodern::lockstep::vi_count() { return total_vis; }
+uint64_t ultramodern::lockstep::virtual_ticks() {
+    // 46,875 counts per ms: 781,250 per VI at 60 Hz.
+    return total_vis * 781250ull + 64ull * (lockstep_reads_in_vi++);
+}
+void ultramodern::lockstep::run_one_vi() {
+    lockstep_step_request.signal();
+    lockstep_step_done.wait();
+}
+#endif
+
