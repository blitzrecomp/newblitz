@@ -25,9 +25,20 @@
 
     for (u16 index = 0; index < 512; index++) {
         u64 a = (index + 512) >> ((index % 2 == 1) ? 1 : 0);
+#if defined(__PSP__)
+        // BlitzRecomp (PSP): the same b by binary search (the test is monotonic in b). The loop below is about 28 million
+        // 64-bit multiplies, 1.9 s of the boot on a 32-bit CPU; the results are identical for every index (checked).
+        u64 lo = u64(1) << 17, hi = u64(1) << 19;
+        while (lo < hi) {
