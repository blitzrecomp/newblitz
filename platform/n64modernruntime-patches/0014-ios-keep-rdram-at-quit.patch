diff --git a/librecomp/src/recomp.cpp b/librecomp/src/recomp.cpp
--- a/librecomp/src/recomp.cpp
+++ b/librecomp/src/recomp.cpp
@@ -1,3 +1,6 @@
+#if defined(__APPLE__)
+#include <TargetConditionals.h>  // BlitzRecomp: TARGET_OS_IPHONE, for the quit below
+#endif
 #include <cstdio>
 #include <cstdlib>
 #include <cstring>
@@ -1004,10 +1007,11 @@
     free_failed = (VirtualFree(rdram, 0, MEM_RELEASE) == 0);
 #elif defined(__PROSPERO__)
     free_failed = false;  // the process ends next; the direct memory goes with it
-#elif defined(__ANDROID__)
+#elif defined(__ANDROID__) || (defined(__APPLE__) && TARGET_OS_IPHONE)
     // Only the game thread was joined: the game's other threads (the pad's poll among them) can still be running, and one that
     // yields after an unmap read freed memory (a SIGSEGV in check_running_queue on an RG DS quit, 2026-11-02, after which
     // GammaOS's system_server hung and restarted). The process ends with the activity, so the memory goes with it.
+    // An iPhone quit from Settings did the same (2026-11-02): its process ends after this too.
     free_failed = false;
 #else
     // munmap returns -1 on failure.
