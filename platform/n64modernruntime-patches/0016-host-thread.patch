new file mode 100644
--- /dev/null
+++ b/ultramodern/include/ultramodern/host_thread.hpp
@@ -0,0 +1,123 @@
+#ifndef __ULTRAMODERN_HOST_THREAD_HPP__
+#define __ULTRAMODERN_HOST_THREAD_HPP__
+
+// BlitzRecomp (PSP port, docs/PSP_PORT.md §4.1): every host thread the runtime starts goes through here, so a
+// platform where std::thread's defaults don't fit (no stack size or priority, a broken condition variable) can start
+// them its own way. The attributes say what each thread is; the default backend ignores them.
+//
+// Default backend (every platform unless ULTRAMODERN_HOST_THREAD_PLATFORM is defined): host_thread_t is std::thread,
+// host_thread(attrs, f, args...) is std::thread{f, args...}, and host_sem is moodycamel's LightweightSemaphore, the
+// type every one of these sites used before. Nothing changes there.
+//
+// ULTRAMODERN_HOST_THREAD_PLATFORM (PSP, psp-host): the platform implements host_thread_create/join/detach below.
+// ULTRAMODERN_HOST_SEM_PLATFORM: the platform also provides class ultramodern::host_sem (wait(), wait(usecs),
+// tryWait(), signal(n)) in "ultramodern_host_sem_platform.hpp".
+// Both change the layout of UltraThreadContext, so they must be global compile definitions.
+
+#include <cstdint>
+#include <thread>
+#include <utility>
+
+#if defined(ULTRAMODERN_HOST_THREAD_PLATFORM)
+#include <functional>
+#include <tuple>
+#include <type_traits>
+#endif
+
+#if defined(ULTRAMODERN_HOST_SEM_PLATFORM)
+#include "ultramodern_host_sem_platform.hpp"
+#else
+#undef MOODYCAMEL_DELETE_FUNCTION
+#define MOODYCAMEL_DELETE_FUNCTION = delete
+#include "lightweightsemaphore.h"
+#endif
+
+namespace ultramodern {
+    // What a host thread is for. The platform picks the stack and priority from these (stack_bytes 0: its default
+    // for that kind).
+    enum class HostThreadKind : uint8_t {
+        Runtime,    // VI, gfx, SP task, timer, thread cleaner, saving
+        GameStart,  // recomp::start's game start thread (runs bootproc and becomes the first game thread)
+        Game,       // one per osCreateThread
+    };
+
+    struct host_thread_attrs {
+        const char* name;
+        HostThreadKind kind;
+        uint32_t stack_bytes;  // 0: the platform's default for the kind
+        int priority;          // PSP-style: lower runs first (docs/PSP_PORT.md §4.1)
+        int game_id;           // Game threads: the OSThread's id and priority (else 0)
+        int game_pri;
+    };
+
+    // The runtime's threads (docs/PSP_PORT.md §4.1 table).
+    namespace host_threads {
+        inline constexpr host_thread_attrs vi{ "VI", HostThreadKind::Runtime, 64 * 1024, 0x10, 0, 0 };
+        inline constexpr host_thread_attrs timer{ "Timer", HostThreadKind::Runtime, 64 * 1024, 0x10, 0, 0 };
+        inline constexpr host_thread_attrs gfx{ "Gfx", HostThreadKind::Runtime, 64 * 1024, 0x18, 0, 0 };
+        inline constexpr host_thread_attrs sp_task{ "SP Task", HostThreadKind::Runtime, 64 * 1024, 0x18, 0, 0 };
+        inline constexpr host_thread_attrs cleaner{ "Cleaner", HostThreadKind::Runtime, 64 * 1024, 0x20, 0, 0 };
+        inline constexpr host_thread_attrs saving{ "Saving", HostThreadKind::Runtime, 64 * 1024, 0x30, 0, 0 };
+        inline constexpr host_thread_attrs game_start{ "Game Start", HostThreadKind::GameStart, 0, 0x20, 0, 0 };
+        inline host_thread_attrs game(int id, int pri) { return { "Game", HostThreadKind::Game, 0, 0x20, id, pri }; }
+    }
+
+#if defined(ULTRAMODERN_HOST_THREAD_PLATFORM)
+    struct host_thread_handle;
+    // Implemented by the platform. host_thread_create runs (*body)() on a new thread and deletes body afterwards;
+    // it never returns null (a platform that can't start a thread reports it and ends the program).
+    host_thread_handle* host_thread_create(const host_thread_attrs& attrs, std::function<void()>* body);
+    void host_thread_join(host_thread_handle* handle);    // waits, then frees the handle
+    void host_thread_detach(host_thread_handle* handle);  // frees the handle once the thread ends
+
+    // The subset of std::thread the runtime uses.
+    class host_thread_t {
+    public:
+        host_thread_t() = default;
+        explicit host_thread_t(host_thread_handle* h) : handle(h) {}
+        host_thread_t(host_thread_t&& other) noexcept : handle(std::exchange(other.handle, nullptr)) {}
+        host_thread_t& operator=(host_thread_t&& other) noexcept {
+            if (handle != nullptr) {
+                std::terminate();  // as std::thread: assigning over a joinable thread
+            }
+            handle = std::exchange(other.handle, nullptr);
+            return *this;
+        }
+        host_thread_t(const host_thread_t&) = delete;
+        host_thread_t& operator=(const host_thread_t&) = delete;
+        ~host_thread_t() {
+            if (handle != nullptr) {
+                std::terminate();  // as std::thread: destroying a joinable thread
+            }
+        }
+        bool joinable() const { return handle != nullptr; }
+        void join() { host_thread_join(std::exchange(handle, nullptr)); }
+        void detach() { host_thread_detach(std::exchange(handle, nullptr)); }
+    private:
+        host_thread_handle* handle = nullptr;
+    };
+
+    template <class F, class... Args>
+    host_thread_t host_thread(const host_thread_attrs& attrs, F&& f, Args&&... args) {
+        // Arguments are decayed copies, as std::thread makes them.
+        auto* body = new std::function<void()>(
+            [fn = std::decay_t<F>(std::forward<F>(f)), tup = std::make_tuple(std::decay_t<Args>(std::forward<Args>(args))...)]() mutable {
+                std::apply(std::move(fn), std::move(tup));
+            });
+        return host_thread_t{ host_thread_create(attrs, body) };
+    }
+#else
+    using host_thread_t = std::thread;
+
+    template <class F, class... Args>
+    inline std::thread host_thread(const host_thread_attrs&, F&& f, Args&&... args) {
+        return std::thread{ std::forward<F>(f), std::forward<Args>(args)... };
+    }
+#endif
+
+#if !defined(ULTRAMODERN_HOST_SEM_PLATFORM)
+    using host_sem = moodycamel::LightweightSemaphore;
+#endif
+}
+
+#endif
