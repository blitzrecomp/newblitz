diff --git a/librecomp/include/librecomp/addresses.hpp b/librecomp/include/librecomp/addresses.hpp
--- a/librecomp/include/librecomp/addresses.hpp
+++ b/librecomp/include/librecomp/addresses.hpp
@@ -6,6 +6,24 @@
 #include "recomp.h"
 
 namespace recomp {
+#if defined(RECOMP_SMALL_RDRAM)
+    // BlitzRecomp (PSP, docs/PSP_PORT.md §4.2): RDRAM is the console's 8 MB and nothing more, a block the platform
+    // provides (recomp::platform_rdram) with no address-space reservation around it. The PI handles and patch data
+    // live in the top 8 KB, which the game never uses (Modern's highest use is about 0x80722300; the runtime's dummy
+    // framebuffers end at 0x807FB000), and there is no mod heap.
+    constexpr size_t mem_size = 8ULL * 1024ULL * 1024ULL;
+    constexpr size_t allocation_size = mem_size;
+    constexpr int32_t cart_handle = 0x807FE000;
+    constexpr int32_t drive_handle = (int32_t)(cart_handle + sizeof(OSPiHandle));
+    constexpr int32_t flash_handle = (int32_t)(drive_handle + sizeof(OSPiHandle));
+    constexpr int32_t flash_handle_end = (int32_t)(flash_handle + sizeof(OSPiHandle));
+    constexpr int32_t patch_rdram_start = 0x807FF000;
+    constexpr int32_t patch_rdram_end = (int32_t)0x80800000;
+    static_assert(patch_rdram_start >= flash_handle_end);
+    constexpr int32_t mod_rdram_start = patch_rdram_end;  // nothing above it: no room for mods (RECOMP_NO_MODS)
+    // The platform's RDRAM: mem_size bytes, zeroed, at a fixed address for the whole run (called once, by recomp::start).
+    uint8_t* platform_rdram(size_t size);
+#else
     // 512GB (kseg0 size)
     constexpr size_t mem_size = 512ULL * 1024ULL * 1024ULL;
     // 4GB (the full address space)
@@ -18,6 +36,7 @@
     constexpr int32_t patch_rdram_start = 0x80801000;
     static_assert(patch_rdram_start >= flash_handle_end);
     constexpr int32_t mod_rdram_start = 0x81000000;
+#endif
 
