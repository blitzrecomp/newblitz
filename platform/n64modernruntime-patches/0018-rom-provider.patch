+    class rom_provider {
+    public:
+        virtual ~rom_provider() = default;
+        virtual size_t size() const = 0;
+        // Copies len bytes from rom_offset (the stored, big-endian byte order) to dst. Bytes past the end read as zero.
+        virtual void read(uint32_t rom_offset, uint8_t* dst, size_t len) = 0;
+    };
+    void set_rom_provider(rom_provider* provider);  // before recomp::start; the provider lives for the whole run
