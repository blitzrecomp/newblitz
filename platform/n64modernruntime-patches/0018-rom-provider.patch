+// Through the provider, a block at a time (BlitzRecomp, PSP). Out of line, so do_rom_read's own frame stays as it was.
+[[gnu::noinline]] static void rom_read_through_provider(uint8_t* rdram, gpr ram_address, uint32_t physical_addr, size_t num_bytes) {
+    uint8_t block[4096];
+    uint32_t rom_offset = physical_addr - recomp::rom_base;
+    for (size_t done = 0; done < num_bytes;) {
+        size_t n = std::min(sizeof(block), num_bytes - done);
+        rom_source->read(rom_offset + (uint32_t)done, block, n);
+        for (size_t i = 0; i < n; i++) {
+            MEM_B(done + i, ram_address) = block[i];
+        }
+        done += n;
+    }
 }
 
