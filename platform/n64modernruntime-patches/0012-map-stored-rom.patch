 void recomp::set_rom_contents(std::vector<uint8_t>&& new_rom) {
+#ifdef RECOMP_ROM_MAP
+    if (rom_map != nullptr) {
+        std::vector<uint8_t> data = std::move(new_rom);  // freed on return
+        if (!rom_from_mods && data.size() <= rom_map_reserved) {
+            const size_t page = (size_t)sysconf(_SC_PAGESIZE);
+            size_t copied = 0;
+            for (size_t off = 0; off < data.size(); off += page) {
+                size_t len = std::min(page, data.size() - off);
+                if (std::memcmp(rom_map + off, data.data() + off, len) != 0) {
+                    std::memcpy(rom_map + off, data.data() + off, len);
+                    copied++;
+                }
+            }
+            rom_view = std::span<const uint8_t>(rom_map, data.size());
+            fprintf(stderr, "[rom] mapped %zu from %s: %zu changed page(s) copied (%zu KB)\n", data.size(),
+                    rom_map_file.c_str(), copied, copied * page / 1024);
+            return;
+        }
+        // A mod's ROM patch, or a ROM too big for the reservation: back to a copy.
+        fprintf(stderr, "[rom] copied (%s)\n", rom_from_mods ? "a mod patches the ROM" : "larger than the mapping");
+        rom = std::move(data);
+        rom_view = rom;
+        if (rom_from_mods) {
+            rom_map_retired = rom_map;
+            rom_map_retired_size = rom_map_reserved;
+            rom_map = nullptr;
+            rom_map_reserved = 0;
+        }
+        else {
+            unmap_rom();
+        }
+        return;
+    }
+#endif
     rom = std::move(new_rom);
+    rom_view = rom;
+}
