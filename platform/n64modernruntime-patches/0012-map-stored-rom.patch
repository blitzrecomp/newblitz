+recomp::RomMapResult recomp::map_rom_file(const std::filesystem::path& path, const std::function<bool(std::span<const uint8_t>)>& check) {
+#ifdef RECOMP_ROM_MAP
+    // On by default in Android's Potato Mode (BLITZ_LEAN), until it's been seen on more devices: BLITZ_ROM_MAP=0 keeps the copy
+    // there; elsewhere BLITZ_ROM_MAP=1 turns it on.
+    const char* env = std::getenv("BLITZ_ROM_MAP");
+#ifdef __ANDROID__
+    if ((env != nullptr) ? (std::strcmp(env, "0") == 0) : (std::getenv("BLITZ_LEAN") == nullptr)) {
+        if (env != nullptr) fprintf(stderr, "[rom] copied (BLITZ_ROM_MAP=0)\n");
+        return RomMapResult::NotMapped;
+    }
+#else
+    if (env == nullptr || std::strcmp(env, "0") == 0) {
+        return RomMapResult::NotMapped;
+    }
+#endif
+    char why[160];
+    int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+    struct stat st{};
+    if (fd < 0 || fstat(fd, &st) != 0 || st.st_size <= 0) {
+        snprintf(why, sizeof(why), "can't open %s: %s", path.c_str(), fd < 0 ? strerror(errno) : "empty or unreadable");
+        if (fd >= 0) close(fd);
+        fprintf(stderr, "[rom] copied (%s)\n", why);
+        return RomMapResult::NotMapped;
+    }
+    const size_t page = (size_t)sysconf(_SC_PAGESIZE);
+    const size_t size = (size_t)st.st_size;
+    const size_t file_span = (size + page - 1) & ~(page - 1);
+    // Room for files added past the end (fs_commit_files) and exported ROMs up to 64 MB. Untouched pages cost nothing.
+    const size_t reserved = std::max<size_t>(64 * 1024 * 1024, 2 * file_span);
+    // Anonymous first, so reads past the file's end see zeros, then the file over its start.
+    uint8_t* base = (uint8_t*)mmap(nullptr, reserved, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    if (base == (uint8_t*)MAP_FAILED ||
+        mmap(base, file_span, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_FIXED, fd, 0) == MAP_FAILED) {
+        snprintf(why, sizeof(why), "mmap failed: %s", strerror(errno));
+        if (base != (uint8_t*)MAP_FAILED) munmap(base, reserved);
+        close(fd);
+        fprintf(stderr, "[rom] copied (%s)\n", why);
+        return RomMapResult::NotMapped;
+    }
+    close(fd);  // the mapping keeps the file open
+
+    // Checked as mapped, so the bytes checked are the bytes the game reads.
+    if (!check(std::span<const uint8_t>(base, size))) {
+        munmap(base, reserved);
+        fprintf(stderr, "[rom] %s failed the ROM check\n", path.c_str());
+        return RomMapResult::Rejected;
+    }
+    unmap_rom();
+    std::vector<uint8_t>().swap(rom);
+    rom_map = base;
+    rom_map_reserved = reserved;
+    rom_map_file = path.string();
+    rom_view = std::span<const uint8_t>(base, size);
+    fprintf(stderr, "[rom] mapped %zu from %s\n", size, rom_map_file.c_str());
+    return RomMapResult::Mapped;
+#else
+    (void)path;
+    (void)check;
+    return RomMapResult::NotMapped;
+#endif
+}
+
+void recomp::set_rom_from_mods(bool from_mods) {
+#ifdef RECOMP_ROM_MAP
+    rom_from_mods = from_mods;
+    if (!from_mods && rom_map_retired != nullptr) {
+        munmap(rom_map_retired, rom_map_retired_size);
+        rom_map_retired = nullptr;
+        rom_map_retired_size = 0;
+    }
+#else
+    (void)from_mods;
+#endif
 }
 
