+// The same on a mapped ROM (map_rom_file). The game's own check takes a vector, so it gets a passing copy.
+static bool rom_matches(const recomp::GameEntry& game_entry, std::span<const uint8_t> rom_data) {
+    if (game_entry.rom_check != nullptr) {
+        return game_entry.rom_check(std::vector<uint8_t>(rom_data.begin(), rom_data.end()));
+    }
+    return XXH3_64bits(rom_data.data(), rom_data.size()) == game_entry.rom_hash;
+}
