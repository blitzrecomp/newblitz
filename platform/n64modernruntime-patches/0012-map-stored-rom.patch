+// BlitzRecomp: the ROM is a copy in memory (rom), or on Android a private mapping of the stored ROM file
+// (map_rom_file). The game reads rom_view either way.
 static std::vector<uint8_t> rom;
+static std::span<const uint8_t> rom_view;
+
+#ifdef RECOMP_ROM_MAP
+// A reserved range with the stored file mapped over its start. Later changes (art, added files) are written into it
+// one page at a time where they differ: only those pages become anonymous memory (copy-on-write), the rest stay
+// the file's.
+static uint8_t* rom_map = nullptr;
+static size_t rom_map_reserved = 0;
+static std::string rom_map_file;
+static bool rom_from_mods = false;
+// A mapping a mod's ROM patch replaced: load_mods still reads it after patching (decompressed_rom, mods.cpp), so it
+// is unmapped once load_mods returns (set_rom_from_mods(false)).
+static uint8_t* rom_map_retired = nullptr;
+static size_t rom_map_retired_size = 0;
+
+static void unmap_rom() {
+    if (rom_map != nullptr) {
+        munmap(rom_map, rom_map_reserved);
+        rom_map = nullptr;
+        rom_map_reserved = 0;
+    }
+}
+#endif
 
