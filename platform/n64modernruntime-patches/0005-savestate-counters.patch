+#include <atomic>
 #include <thread>
 
 #include "blockingconcurrentqueue.h"
@@ -13,18 +14,48 @@ struct QueuedMessage {
 };
 
 static moodycamel::BlockingConcurrentQueue<QueuedMessage> external_messages {};
+// Messages that must reach the game (RSP/RDP done, PI DMA done, SI): sent but not yet delivered.
+static std::atomic_int must_deliver_pending{0};
 
 void ultramodern::enqueue_external_message(PTR(OSMesgQueue) mq, OSMesg msg, bool jam, bool requeue_if_blocked) {
+    if (requeue_if_blocked) {
+        must_deliver_pending++;
+    }
     external_messages.enqueue({mq, msg, jam, requeue_if_blocked});
 }
 
+int ultramodern::pending_must_deliver_messages() {
+    return must_deliver_pending.load();
+}
+
+// Drops every queued external message (save-state restore; only VI/AI ones should be left then).
+void ultramodern::discard_external_messages() {
+    QueuedMessage m;
+    while (external_messages.try_dequeue(m)) {
+        if (m.requeue_if_blocked) {
+            must_deliver_pending--;
+        }
+    }
+}
+
+// Sends one dequeued external message; must-deliver ones that don't fit go back in the queue.
+static bool send_external(RDRAM_ARG const QueuedMessage& m);
+
 bool do_send(RDRAM_ARG PTR(OSMesgQueue) mq_, OSMesg msg, bool jam, bool block);
 
+static bool send_external(RDRAM_ARG const QueuedMessage& m) {
+    bool sent = do_send(PASS_RDRAM m.mq, m.mesg, m.jam, false);
+    if (sent && m.requeue_if_blocked) {
+        must_deliver_pending--;
+    }
+    return sent;
+}
