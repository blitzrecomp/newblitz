+// BlitzRecomp: soft reset (ultramodern.hpp, 2026-11-27). Restart without leaving the app, the way an N64's reset starts
+// the game again: the boot thread, once the game it booted is running, waits for a request; then the game's threads end,
+// its timers, RSP work and event queues go, the app's callback runs with nothing of the game running, RDRAM is cleared,
+// and the same boot runs again (or, to the launcher, waits for the next start_game). The renderer, the window, the UI,
+// audio and the runtime's own threads stay as they are.
+static std::atomic_int soft_reset_request{0};  // 0 none, 1 boot again, 2 to the launcher
+static std::atomic_bool game_resetting{false};
+static std::atomic_int soft_resets_done{0};
+static std::function<void(bool)> soft_reset_between;
+static std::function<void()> soft_reset_failed;
+
+bool ultramodern::is_game_resetting() {
+    return game_resetting.load();
+}
+
+bool recomp::request_soft_reset(bool to_launcher) {
+    if (exited.load() || game_status.load() != GameStatus::Running || game_resetting.load()) {
+        return false;
+    }
+    int expected = 0;
+    return soft_reset_request.compare_exchange_strong(expected, to_launcher ? 2 : 1);
+}
+
+void recomp::set_soft_reset_callbacks(std::function<void(bool to_launcher)> between, std::function<void()> failed) {
+    soft_reset_between = std::move(between);
+    soft_reset_failed = std::move(failed);
+}
+
+int recomp::soft_reset_count() {
+    return soft_resets_done.load();
+}
+
+// The game's RAM as the first boot found it: zero. The first 16 MB (the N64's 8 MB, the PI handles and the patch area)
+// in place; above that (the mod area and heap) the pages are handed back, so they read zero without being touched.
+static void clear_rdram_for_boot(uint8_t* rdram) {
+    const size_t low = std::min<size_t>(16ull * 1024 * 1024, recomp::mem_size);
+    std::memset(rdram, 0, low);
+    if (recomp::mem_size <= low) {
+        return;
+    }
+    uint8_t* high = rdram + low;
+    const size_t high_size = recomp::mem_size - low;
+#if defined(RECOMP_SMALL_RDRAM)
+    (void)high; (void)high_size;
+#elif defined(_WIN32)
+    if (!VirtualFree(high, high_size, MEM_DECOMMIT) || VirtualAlloc(high, high_size, MEM_COMMIT, PAGE_READWRITE) == nullptr) {
+        fprintf(stderr, "[reset] couldn't hand back the upper RDRAM (%lu): left as it is\n", GetLastError());
+    }
+#elif defined(__PROSPERO__)
+    (void)high; (void)high_size;  // direct memory there: the heap is set up again over it (init_heap)
+#else
+    if (mmap(high, high_size, PROT_READ | PROT_WRITE, MAP_FIXED | MAP_ANON | MAP_PRIVATE, -1, 0) == MAP_FAILED) {
+        fprintf(stderr, "[reset] couldn't hand back the upper RDRAM (%s): left as it is\n", strerror(errno));
+    }
+#endif
+}
+
+static bool wait_for_soft_reset_request() {
+    while (!exited.load()) {
+        if (soft_reset_request.load() != 0) {
+            return true;
+        }
+        ultramodern::sleep_milliseconds(5);
+    }
+    return false;
+}
+
+static bool soft_reset(uint8_t* rdram) {
+    const bool to_launcher = soft_reset_request.load() == 2;
+    const int n = soft_resets_done.load() + 1;
+    auto t0 = std::chrono::steady_clock::now();
+    auto ms = [&] { return (long long)std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - t0).count(); };
+    fprintf(stderr, "[reset] soft reset %d%s: stopping the game (%d thread(s))\n", n, to_launcher ? " to the launcher" : "",
+            ultramodern::live_game_threads());
+    game_resetting.store(true);
+    bool ok = ultramodern::stop_game_threads(rdram, 3000);
+    if (ok) {
+        fprintf(stderr, "[reset] game threads stopped at %lld ms\n", ms());
+        ultramodern::reset_timers();
+        ok = ultramodern::reset_events(rdram, 3000);
+    }
+    if (!ok) {
+        fprintf(stderr, "[reset] soft reset %d failed at %lld ms: the game can't be started again in place\n", n, ms());
+        soft_reset_request.store(0);
+        if (soft_reset_failed) {
+            soft_reset_failed();
+        }
+        return false;
+    }
+    ultramodern::reset_external_messages();
+    ultramodern::reset_thread_queues();
+    ultramodern::flush_saving();
+    if (soft_reset_between) {
+        soft_reset_between(to_launcher);
+    }
+    clear_rdram_for_boot(rdram);
+    ultramodern::reset_external_messages();
+    if (to_launcher) {
+        std::lock_guard<std::mutex> lock(current_game_mutex);
+        game_status.store(GameStatus::None);
+        current_game.reset();
+    }
+    soft_reset_request.store(0);
+    soft_resets_done.store(n);
+    game_resetting.store(false);
+    fprintf(stderr, "[reset] soft reset %d done at %lld ms: %s\n", n, ms(), to_launcher ? "the launcher" : "booting again");
+    return true;
+}
