+    // Shape of the framebuffer image on a 4:3 screen, from the VI scale registers. A non-interlaced 320x240
+    // buffer at the usual scales gives exactly 4:3, but a game can stretch a differently shaped buffer to
+    // fill the screen (NFL Blitz renders 512x256 and scales it to about 594x225 of the 640x240 frame).
+    // Only non-interlaced modes are accounted for (the height is compared with 240 lines); interlaced
+    // 480-line modes would come out wrong. This port only uses Blitz's own mode. Falls back to the
+    // buffer's own width/height when the registers give an implausible result.
+    float VI::displayAspectRatio() const {
+        const hlslpp::uint2 size = fbSize();
+        if ((size.x == 0) || (size.y == 0)) {
+            return 4.0f / 3.0f;
+        }
+
+        const float bufferRatio = float(size.x) / float(size.y);
+        if ((xTransform.xScale == 0) || (yTransform.yScale == 0)) {
+            return bufferRatio;
+        }
+
+        const float screenWidthFraction = (float(size.x) * xScaleFloat()) / 640.0f;
+        const float screenHeightFraction = (float(size.y) * yScaleFloat()) / 240.0f;
+        const float ratio = (screenWidthFraction / screenHeightFraction) * (4.0f / 3.0f);
+        if (!(ratio >= 0.5f) || !(ratio <= 4.0f)) {
+            return bufferRatio;
+        }
+
+        return ratio;
+    }
+
     float VI::xScaleFloat() const {
         return (1024.0f / xTransform.xScale);
     }
