+    if (NOT APPLE AND FILENAME MATCHES "Fb(WriteColor|WriteDepth|ReadAnyFull|ReadAnyChanges)CS")
         set(SPV_FIXUP COMMAND python3 ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/src/shaders/spirv_unknown_formats.py ${OUTNAME}.spv)
