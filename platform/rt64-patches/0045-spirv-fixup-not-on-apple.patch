@@ -137,13 +137,21 @@ set (DXC_RT_OPTS "${DXC_COMMON_OPTS}" "-D" "RT_SHADER" "-T" "lib_6_3" "-fspv-tar
 function(build_shader_spirv_impl TARGETOBJ FILENAME TARGET_NAME OUTNAME)
     # Blitz: the frame read and write shaders' formats as Unknown (src/shaders/spirv_unknown_formats.py).
     set(SPV_FIXUP "")
-    if (FILENAME MATCHES "Fb(WriteColor|WriteDepth|ReadAnyFull|ReadAnyChanges)CS")
