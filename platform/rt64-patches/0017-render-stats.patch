+    std::atomic<uint64_t> statQueued{0}, statCompiled{0}, statCompileMs{0}, statDrawsUber{0}, statDrawsFast{0}, statGpuWaitMs{0};
+}
+
+extern "C" void blitz_rt64_stats(uint64_t *queued, uint64_t *compiled, uint64_t *compileMs, uint64_t *uber, uint64_t *fast, uint64_t *gpuWaitMs) {
+    *queued = RT64::statQueued.load();
+    *compiled = RT64::statCompiled.load();
+    *compileMs = RT64::statCompileMs.exchange(0);
+    *uber = RT64::statDrawsUber.exchange(0);
+    *fast = RT64::statDrawsFast.exchange(0);
+    *gpuWaitMs = RT64::statGpuWaitMs.exchange(0);
+}
