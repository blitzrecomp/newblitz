+    // The clear 4x4 texture in slot 0, read the whole way: wrapped to its size, so a miss can't read past it.
+    void FramebufferRenderer::compactMissTile(interop::GPUTile &gpuTile) {
+        gpuTile.textureIndex = 0;
+        gpuTile.textureDimensions = interop::float3(4.0f, 4.0f, 1.0f);
+        gpuTile.tcScale.x = gpuTile.tcScale.y = 1.0f;
+        gpuTile.ulScale.x = gpuTile.ulScale.y = 1.0f;
+        gpuTile.texelShift = { 0, 0 };
+        gpuTile.texelMask = { 3, 3 };
+        gpuTile.flags.rawTMEM = false;
+        gpuTile.flags.hasMipmaps = false;
+        gpuTile.flags.highRes = false;
+        gpuTile.flags.fromCopy = false;
+    }
