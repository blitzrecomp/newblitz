+// BLITZ DS (the game's src/game/ds_view.cpp, docs/BLITZ_DS.md): a second screen, drawn by this thread right after the
+// first and presented right after it. Each gets its own submit and wait, in turn, since the emulator's Android stalls
+// when two swap chains are drawn within one (tools/android/probe, 2026-10-31).
+//   blitz_ds_mode 0: one screen, as ever. 1: the picture over both. 2: the picture on the first, the second has only
+//   the hook's drawing.
+extern "C" {
+    extern volatile float blitz_tall_aspect_on;
+    volatile int blitz_ds_mode = 0;
+    volatile float blitz_ds_split = 0.5f;        // the upper screen's share of the picture's height
+    volatile int blitz_ds_second_on_top = 1;     // the second window is the upper screen
+    void (*blitz_ds_second_hook)(plume::RenderCommandList *, plume::RenderFramebuffer *) = nullptr;
+    volatile uint64_t blitz_ds_second_frames = 0;
+    volatile uint64_t blitz_ds_second_failures = 0;
+    volatile float blitz_ds_second_ms = 0.0f;    // the last frame's time on this thread, second screen's part
+    volatile int blitz_ds_clip_enabled = 0;      // keep the last play (memory: about 47 MB)
+    volatile int blitz_ds_clip_restart = 0;      // the next frame starts a new clip (set as play select ends)
+    volatile int blitz_ds_clip_show = 0;         // show it now, on the left of the second screen
+    volatile int blitz_ds_clip_frames = 0;       // how many frames it has
+    volatile int blitz_ds_second_dirty = 1;      // the panel changed (recompui::ds_panel_set)
+
+    static std::mutex blitz_ds_window_mutex;
+    static std::condition_variable blitz_ds_window_changed;
+    static plume::RenderWindow blitz_ds_window{};
+    static bool blitz_ds_window_set = false;
+    static uint64_t blitz_ds_window_generation = 0;
+    static uint64_t blitz_ds_window_taken = 0;
+
+    // From any thread; a and b as the platform's RenderWindow (Android: the ANativeWindow; Mac: window, layer). Null a
+    // takes it away: this returns once the present thread has let go, so a surface being destroyed is safe.
+    void blitz_ds_set_window(void *a, void *b) {
+        std::unique_lock<std::mutex> lock(blitz_ds_window_mutex);
+#if defined(__ANDROID__)
+        (void)b;
+        blitz_ds_window = (plume::RenderWindow)a;
+#elif defined(__APPLE__)
+        blitz_ds_window = plume::RenderWindow{ a, b };
+#else
+        (void)b;
+        if (a != nullptr) return;  // Mac and Android only so far
+#endif
+        blitz_ds_window_set = a != nullptr;
+        const uint64_t generation = ++blitz_ds_window_generation;
+        blitz_ds_window_changed.wait_for(lock, std::chrono::milliseconds(a != nullptr ? 0 : 1000), [&]() { return blitz_ds_window_taken >= generation; });
+    }
+}
