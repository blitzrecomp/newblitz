+    void PresentQueue::secondUpdate() {
+        std::unique_lock<std::mutex> lock(blitz_ds_window_mutex);
+        if (secondGeneration != blitz_ds_window_generation) {
+            const bool set = blitz_ds_window_set;
+            const RenderWindow window = blitz_ds_window;
+            const uint64_t generation = blitz_ds_window_generation;
+            ext.presentGraphicsWorker->commandList->begin();
+            ext.presentGraphicsWorker->commandList->end();
+            ext.presentGraphicsWorker->execute();
+            ext.presentGraphicsWorker->wait();
+            secondFramebuffers.clear();
+            secondChain.reset();
+            secondValid = false;
+            if (set) {
+                RenderSwapChainDesc desc;
+                desc.renderWindow = window;
+#   if defined(__ANDROID__)
+                desc.format = RenderFormat::R8G8B8A8_UNORM;
+#   else
+                desc.format = RenderFormat::B8G8R8A8_UNORM;
+#   endif
+                desc.textureCount = 2;
+                secondChain = ext.presentGraphicsWorker->commandQueue->createSwapChain(desc);
+                secondValid = (secondChain != nullptr) && !secondChain->needsResize();
+                fprintf(stderr, "[ds] second swap chain: %s, %ux%u\n", (secondChain != nullptr) ? "made" : "FAILED", (secondChain != nullptr) ? secondChain->getWidth() : 0, (secondChain != nullptr) ? secondChain->getHeight() : 0);
+                if (secondAcquired == nullptr) {
+                    secondAcquired = ext.device->createCommandSemaphore();
+                }
+            }
+            else {
+                fprintf(stderr, "[ds] second swap chain let go\n");
+            }
+
+            secondGeneration = generation;
+            blitz_ds_window_taken = generation;
+            blitz_ds_window_changed.notify_all();
+        }
+
+        // A chain the driver won't make is tried again once a second, not every frame.
+        const auto now = std::chrono::steady_clock::now();
+        if ((secondChain != nullptr) && (secondChain->needsResize() || !secondValid) && ((now - secondLastResize) > std::chrono::seconds(1))) {
+            secondLastResize = now;
+            lock.unlock();
+            secondValid = secondChain->resize();
+            secondFramebuffers.clear();
+            secondLastMode = -1;
+            if (secondValid || secondResizeLogged) {
+                fprintf(stderr, "[ds] second swap chain resized: %s, %ux%u\n", secondValid ? "ok" : "FAILED", secondChain->getWidth(), secondChain->getHeight());
+            }
+
+            secondResizeLogged = secondValid;
+        }
+
+        if ((secondChain != nullptr) && secondValid) {
+            while (secondDrawSemaphores.size() < secondChain->getTextureCount()) {
+                secondDrawSemaphores.emplace_back(ext.device->createCommandSemaphore());
+            }
+
+            if (secondFramebuffers.empty()) {
+                secondFramebuffers.resize(secondChain->getTextureCount());
+                for (uint32_t i = 0; i < secondChain->getTextureCount(); i++) {
+                    const RenderTexture *texture = secondChain->getTexture(i);
+                    secondFramebuffers[i] = ext.device->createFramebuffer(RenderFramebufferDesc(&texture, 1));
+                }
+            }
+        }
+    }
+
+    // Draws the second screen and waits for it; present it with index afterwards. False: nothing to present.
+    bool PresentQueue::secondDraw(const VIRenderer::RenderParams &first, uint32_t &index) {
+        if ((secondChain == nullptr) || !secondValid) {
+            return false;
+        }
+
+        const auto start = std::chrono::steady_clock::now();
+        const int mode = blitz_ds_mode;
+
+        // Nothing has changed on a panel: what's on the screen stays. A redraw a second, in case a compositor lost it.
+        if ((mode == 2) && (secondLastMode == 2) && (blitz_ds_clip_show == 0) && (blitz_ds_second_dirty == 0) && ((start - secondLastDraw) < std::chrono::seconds(1))) {
+            return false;
+        }
+
+        secondLastMode = mode;
+        secondLastDraw = start;
+        blitz_ds_second_dirty = 0;
+        secondValid = secondChain->acquireTexture(secondAcquired.get(), &index);
+        if (!secondValid) {
+            blitz_ds_second_failures = blitz_ds_second_failures + 1;
+            return false;
+        }
+
+        RenderTexture *texture = secondChain->getTexture(index);
+        RenderFramebuffer *framebuffer = secondFramebuffers[index].get();
+        RenderCommandList *commandList = ext.presentGraphicsWorker->commandList.get();
+        commandList->begin();
+
+        // The clip. A new play starts it over; 15 frames a second of the last 8 seconds, at 256x384.
+        constexpr uint32_t ClipLength = 120, ClipWidth = 256, ClipHeight = 384;
+        if ((blitz_ds_clip_enabled == 0) && !clipTextures.empty()) {
+            // Turned off because play's too slow: its memory goes too. Nothing's using it: the last submit has finished.
+            clipFramebuffers.clear();
+            clipTextures.clear();
+            clipRenderer.reset();
+            clipCount = 0;
+            blitz_ds_clip_frames = 0;
+            fprintf(stderr, "[ds] clip memory freed\n");
+        }
+
+        if (blitz_ds_clip_restart != 0) {
+            blitz_ds_clip_restart = 0;
+            clipShown = 0;
+            clipHead = 0;
+            clipCount = 0;
+            blitz_ds_clip_frames = 0;
+        }
+        if ((blitz_ds_clip_enabled != 0) && (clipTextures.empty())) {
+#   if defined(__ANDROID__)
+            const RenderFormat clipFormat = RenderFormat::R8G8B8A8_UNORM;
+#   else
+            const RenderFormat clipFormat = RenderFormat::B8G8R8A8_UNORM;
+#   endif
+            clipRenderer = std::make_unique<VIRenderer>();
+            for (uint32_t i = 0; i < ClipLength; i++) {
+                clipTextures.emplace_back(ext.device->createTexture(RenderTextureDesc::ColorTarget(ClipWidth, ClipHeight, clipFormat)));
+                const RenderTexture *attachment = clipTextures.back().get();
+                clipFramebuffers.emplace_back(ext.device->createFramebuffer(RenderFramebufferDesc(&attachment, 1)));
+            }
+            fprintf(stderr, "[ds] clip memory made: %u frames at %ux%u\n", ClipLength, ClipWidth, ClipHeight);
+        }
+        if ((blitz_ds_clip_enabled != 0) && (mode == 1) && (first.texture != nullptr) && ((start - clipLastCapture) > std::chrono::milliseconds(62))) {
+            clipLastCapture = start;
+            RenderTexture *clipTexture = clipTextures[clipHead].get();
+            commandList->barriers(RenderBarrierStage::GRAPHICS, RenderTextureBarrier(clipTexture, RenderTextureLayout::COLOR_WRITE));
+            commandList->setFramebuffer(clipFramebuffers[clipHead].get());
+            VIRenderer::RenderParams p = first;
+            p.commandList = commandList;
+            p.swapChain = secondChain.get();
+            p.part = true;
+            p.partTop = 0.0f;
+            p.partBottom = 1.0f;
+            p.targetWidth = ClipWidth;
+            p.targetHeight = ClipHeight;
+            commandList->barriers(RenderBarrierStage::GRAPHICS, RenderTextureBarrier(p.texture, RenderTextureLayout::SHADER_READ));
+            clipRenderer->render(p);
+            commandList->barriers(RenderBarrierStage::GRAPHICS, RenderTextureBarrier(clipTexture, RenderTextureLayout::SHADER_READ));
+            clipHead = (clipHead + 1) % ClipLength;
+            clipCount = std::min(clipCount + 1, ClipLength);
+            blitz_ds_clip_frames = int(clipCount);
+        }
+
+        commandList->barriers(RenderBarrierStage::GRAPHICS, RenderTextureBarrier(texture, RenderTextureLayout::COLOR_WRITE));
+        commandList->setFramebuffer(framebuffer);
+        commandList->clearColor();
+
+        if ((mode == 2) && (blitz_ds_clip_show != 0) && (blitz_ds_clip_enabled != 0) && (clipCount > 0) && (first.vi != nullptr)) {
+            if ((start - clipLastShown) > std::chrono::milliseconds(66)) {
+                clipLastShown = start;
+                clipShown = (clipShown + 1) % clipCount;
+            }
+            const uint32_t oldest = (clipCount == ClipLength) ? clipHead : 0;
+            VIRenderer::RenderParams p = first;
+            p.commandList = commandList;
+            p.swapChain = secondChain.get();
+            p.texture = clipTextures[(oldest + std::min(clipShown, clipCount - 1)) % ClipLength].get();
+            p.textureWidth = ClipWidth;
+            p.textureHeight = ClipHeight;
+            p.downsamplingScale = 1;
+            p.part = false;
+            p.stored = true;
+            const int32_t height = int32_t(secondChain->getHeight());
+            p.storedRect = RenderRect(0, 0, (height * 2) / 3, height);
+            viRenderer->render(p);
+        }
+        else if ((mode == 1) && (first.texture != nullptr)) {
+            VIRenderer::RenderParams p = first;
+            p.commandList = commandList;
+            p.swapChain = secondChain.get();
+            p.part = true;
+            p.partTop = (blitz_ds_second_on_top != 0) ? 0.0f : blitz_ds_split;
+            p.partBottom = (blitz_ds_second_on_top != 0) ? blitz_ds_split : 1.0f;
+            commandList->barriers(RenderBarrierStage::GRAPHICS, RenderTextureBarrier(p.texture, RenderTextureLayout::SHADER_READ));
+            viRenderer->render(p);
+        }
+
+        if (blitz_ds_second_hook != nullptr) {
+            blitz_ds_second_hook(commandList, framebuffer);
+        }
+
+        commandList->barriers(RenderBarrierStage::NONE, RenderTextureBarrier(texture, RenderTextureLayout::PRESENT));
+        commandList->end();
+        const RenderCommandList *submitted = commandList;
+        RenderCommandSemaphore *waitSemaphore = secondAcquired.get();
+        RenderCommandSemaphore *signalSemaphore = secondDrawSemaphores[index].get();
+        ext.presentGraphicsWorker->commandQueue->executeCommandLists(&submitted, 1, &waitSemaphore, 1, &signalSemaphore, 1, ext.presentGraphicsWorker->commandFence.get());
+        ext.presentGraphicsWorker->wait();
+        blitz_ds_second_ms = std::chrono::duration<float, std::milli>(std::chrono::steady_clock::now() - start).count();
+        blitz_ds_second_frames = blitz_ds_second_frames + 1;
+        return true;
+    }
