@@ -72,3 +72,29 @@
         }
     }
 }
+
+// iOS refuses GPU work from an app in the background, and what a refused command buffer should have drawn or uploaded is
+// left undefined (magenta on Metal); a run of refusals can also get the app's next submissions ignored for a while after it's
+// back (the team's iPhone, 2026-11-26: the menus' panels magenta for the rest of the session after the app switcher).
+// blitz_rt64_gpu_away (rt64_present_queue.cpp; the app calls it from SDL's did-enter-background and did-become-active events)
+// sets blitz_gpu_away, and every RT64 thread that submits GPU work waits at its next submission until the app is back. Never
+// set on other platforms. The thread that set it (the main thread) never waits.
+extern "C" {
+    extern volatile int blitz_gpu_away;
+    void blitz_rt64_gpu_away(int away);
+}
+
+namespace RT64 {
+    void blitzGpuAwayPark(int thread, bool (*running)(const void *), const void *context);
+
+    // Returns at once unless the app is away; then once it's back or running() turns false. thread: a BlitzWatchThread whose
+    // phase reads "background" meanwhile, or -1.
+    template <typename Running>
+    inline void blitzGpuAwayWait(int thread, const Running &running) {
+        if (blitz_gpu_away == 0) {
+            return;
+        }
+
+        blitzGpuAwayPark(thread, [](const void *context) { return bool((*static_cast<const Running *>(context))()); }, &running);
+    }
+}
