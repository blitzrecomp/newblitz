+// The app in the background on iOS: no GPU work (rt64_blitz_watch.h).
+static std::atomic<std::thread::id> blitzGpuAwaySetter{};
+extern "C" {
+    volatile int blitz_gpu_away = 0;
+
+    void blitz_rt64_gpu_away(int away) {
+        if (away == 0) {
+            if (blitz_gpu_away != 0) {
+                blitz_gpu_away = 0;
+                fprintf(stderr, "[gpu] back: RT64's GPU work goes on\n");
+            }
+            return;
+        }
+
+        if (blitz_gpu_away != 0) {
+            return;
+        }
+
+        blitzGpuAwaySetter = std::this_thread::get_id();
+        blitz_gpu_away = 1;
+
+        // Give a submission already under way a moment to finish (iOS wants the GPU work done before the app's suspended):
+        // the present, workload and texture threads each back at their wait, or parked.
+        const auto start = std::chrono::steady_clock::now();
+        auto settled = [](RT64::BlitzWatchThread thread) {
+            const char *phase = RT64::blitzPhaseNow(thread);
+            return (phase == nullptr) || (strcmp(phase, "idle") == 0) || (strcmp(phase, "background") == 0);
+        };
+
+        bool allSettled = false;
+        while (std::chrono::steady_clock::now() - start < std::chrono::milliseconds(300)) {
+            allSettled = settled(RT64::BlitzWatchPresent) && settled(RT64::BlitzWatchWorkload) && settled(RT64::BlitzWatchTexture);
+            if (allSettled) {
+                break;
+            }
+
+            std::this_thread::sleep_for(std::chrono::milliseconds(2));
+        }
+
+        const long long ms = (long long)(std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count());
+        fprintf(stderr, "[gpu] background: RT64 holds its GPU work until the app is back (%s after %lld ms)\n", allSettled ? "settled" : "still busy", ms);
+    }
+}
+
 namespace RT64 {
+    void blitzGpuAwayPark(int thread, bool (*running)(const void *), const void *context) {
+        if ((blitz_gpu_away == 0) || (std::this_thread::get_id() == blitzGpuAwaySetter.load())) {
+            return;
+        }
+
+        const char *previous = (thread >= 0) ? blitzPhaseNow(BlitzWatchThread(thread)) : nullptr;
+        if (thread >= 0) {
+            blitzPhase(BlitzWatchThread(thread), "background");
+        }
+
+        while ((blitz_gpu_away != 0) && running(context)) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(5));
+        }
+
+        if (thread >= 0) {
+            blitzPhase(BlitzWatchThread(thread), (previous != nullptr) ? previous : "idle");
+        }
+    }
+
