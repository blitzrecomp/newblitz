+// BLITZ_FAST_FILTER (FrameParams.fastFilter): one hardware bilinear fetch in place of the four nearest ones below and their
+// blend. Same texture, same wrap/mirror/clamp, same four texels: the exact path takes texel floor(uvCoord) and leans towards
+// the next one by frac(uvCoord), which is where the sampler's own bilinear lands for uvCoord + 0.5 over the size. What changes
+// is the blend: the N64's three-point triangle becomes a four-point square (identical when linearFiltering already asks for
+// bilinear, and for G_TF_AVERAGE's middle-of-four case), and the fraction is the sampler's (8 bits on most GPUs).
+float4 sampleTextureNativeBilinear(Texture2D texture, uint nativeSampler, float2 uvCoord, float2 textureSize) {
+    float2 nativeUVCoord = (uvCoord + 0.5f) / textureSize;
+    switch (nativeSampler) {
+        case NATIVE_SAMPLER_WRAP_WRAP:
+            return texture.SampleLevel(gLinearWrapWrapSampler, nativeUVCoord, 0.0f);
+        case NATIVE_SAMPLER_WRAP_MIRROR:
+            return texture.SampleLevel(gLinearWrapMirrorSampler, nativeUVCoord, 0.0f);
+        case NATIVE_SAMPLER_WRAP_CLAMP:
+            return texture.SampleLevel(gLinearWrapClampSampler, nativeUVCoord, 0.0f);
+        case NATIVE_SAMPLER_MIRROR_WRAP:
+            return texture.SampleLevel(gLinearMirrorWrapSampler, nativeUVCoord, 0.0f);
+        case NATIVE_SAMPLER_MIRROR_MIRROR:
+            return texture.SampleLevel(gLinearMirrorMirrorSampler, nativeUVCoord, 0.0f);
+        case NATIVE_SAMPLER_MIRROR_CLAMP:
+            return texture.SampleLevel(gLinearMirrorClampSampler, nativeUVCoord, 0.0f);
+        case NATIVE_SAMPLER_CLAMP_WRAP:
+            return texture.SampleLevel(gLinearClampWrapSampler, nativeUVCoord, 0.0f);
+        case NATIVE_SAMPLER_CLAMP_MIRROR:
+            return texture.SampleLevel(gLinearClampMirrorSampler, nativeUVCoord, 0.0f);
+        case NATIVE_SAMPLER_CLAMP_CLAMP:
+        default:
+            return texture.SampleLevel(gLinearClampClampSampler, nativeUVCoord, 0.0f);
+    }
+}
