diff --git a/src/common/rt64_blitz_watch.h b/src/common/rt64_blitz_watch.h
new file mode 100644
index 0000000..8c07812
--- /dev/null
+++ b/src/common/rt64_blitz_watch.h
@@ -0,0 +1,68 @@
+//
+// RT64
+//
+// Potato Mode's stall watchdog (src/main/fps_counter.cpp) reads these from a thread of its own, since a stalled thread can't
+// report itself: what each renderer thread is doing right now, and running totals. Only ever relaxed atomics, so cheap enough
+// for every device; only Potato Mode reads them. Defined in rt64_raster_shader_cache.cpp, beside the other stats.
+//
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+#if defined(__ANDROID__)
+#   include <unistd.h>
+#endif
+
+namespace RT64 {
+    enum BlitzWatchThread {
+        BlitzWatchGfx = 0,
+        BlitzWatchPresent,
+        BlitzWatchWorkload,
+        BlitzWatchTexture,
+        BlitzWatchThreads
+    };
+
+    extern std::atomic<const char *> blitzWatchPhase[BlitzWatchThreads];
+    extern std::atomic<int> blitzWatchTid[BlitzWatchThreads];
+
+    extern std::atomic<uint64_t> statEvictions, statUploads, statUploadWaitUs, statCompileMsTotal;
+    extern std::atomic<uint64_t> statFirstPresents, statSecondPresents;
+    extern std::atomic<uint64_t> statViPasses, statViPassUs, statViPassMaxUs, statAcquireUs, statPresentUs, statSecondPasses, statSecondPassUs;
+    extern std::atomic<uint64_t> statTextureHighest, statTexturesPast256, statTextureDraws;
+    extern std::atomic<uint32_t> statTargetWidth, statTargetHeight, statScaleHundredths, statChainWidth, statChainHeight, statChainImages, statSecondWidth, statSecondHeight, statSecondImages;
+
+    // A short name that lives forever: a string literal.
+    inline void blitzPhase(BlitzWatchThread thread, const char *phase) {
+        blitzWatchPhase[thread].store(phase, std::memory_order_relaxed);
+    }
+
+    inline const char *blitzPhaseNow(BlitzWatchThread thread) {
+        return blitzWatchPhase[thread].load(std::memory_order_relaxed);
+    }
+
+    // On the thread itself, so the watchdog can read its faults and state from /proc.
+    inline void blitzWatchRegister(BlitzWatchThread thread) {
+#   if defined(__ANDROID__)
+        blitzWatchTid[thread].store(int(gettid()), std::memory_order_relaxed);
+#   else
+        (void)thread;
+#   endif
+    }
+
+    inline void blitzNotePeak(std::atomic<uint64_t> &peak, uint64_t value) {
+        if (value > peak.load(std::memory_order_relaxed)) {
+            peak.store(value, std::memory_order_relaxed);
+        }
+    }
+
+    // A texture index going into a draw. What the GPU really samples, unlike the last slot handed out.
+    inline void blitzNoteTexture(uint32_t index) {
+        statTextureDraws.fetch_add(1, std::memory_order_relaxed);
+        blitzNotePeak(statTextureHighest, index);
+        if (index >= 256) {
+            statTexturesPast256.fetch_add(1, std::memory_order_relaxed);
+        }
+    }
+}
