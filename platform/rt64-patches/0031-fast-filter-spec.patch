+
+    // BLITZ_FAST_FILTER_SPEC=1 (off unless asked for, everywhere): a specialized pipeline gets the fast filter mode as a constant
+    // (constant_id 5, TextureSampler.hlsli) instead of reading FrParams, so it keeps only the path it takes: with the mode on,
+    // the exact filter's four fetches and blend leave it, and its register count (occupancy on Mali) is the fast path's. The mode
+    // is the one when the pipeline is made; a frame whose mode differs (changed live since) draws those with the ubershader,
+    // which still reads FrParams (rt64_framebuffer_renderer.cpp). Unset, the constant is 0 and the shader reads FrParams as before.
+    // A new value means new SPIR-V, so the driver's pipeline cache (pipeline_cache.bin in Potato Mode) misses once and keeps both.
+    static uint32_t fastFilterToBake() {
+        static const bool spec = []() {
+            const char *v = getenv("BLITZ_FAST_FILTER_SPEC");
+            return (v != nullptr) && (atoi(v) != 0);
+        }();
+
+        if (!spec) {
+            return 0;
+        }
+
+        const uint32_t mode = fastFilterModeNow();
+        static std::atomic<bool> told{ false };
+        if (!told.exchange(true)) {
+            fprintf(stderr, "[rt64] BLITZ_FAST_FILTER_SPEC: specialized pipelines bake fast filter mode %u (a live change draws them with the ubershader)\n", mode);
+        }
+
+        return mode;
+    }
+
+    static bool fastFilterTakes(uint32_t mode, bool rect) {
+        // As fastFilterFor in TextureSampler.hlsli.
+        return (mode == 1) || ((mode == 2) && !rect);
+    }
